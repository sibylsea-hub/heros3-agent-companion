+
 const std::string & TextLocalizationContainer::translateString(const TextIdentifier & identifier) const
 {
 	std::lock_guard globalLock(globalTextMutex);
 
+	// H3 Mod local patch: a player colour shown as another colour is also called by that colour's name.
+	// Texts with one entry per colour: the names, and "owned by the red player" ... (arraytxt 23-30)
+	struct ColorTexts
+	{
+		const char * prefix;
+		int first;
+	};
+	static const ColorTexts colorTexts[] = {{"vcmi.capitalColors.", 0}, {"core.plcolors.", 0}, {"core.arraytxt.", 23}};
+	const std::string & id = identifier.get();
+	if(id.size() > 14 && (id[0] == 'v' || id[0] == 'c') && id.back() >= '0' && id.back() <= '9')
+	{
+		for(const auto & texts : colorTexts)
+		{
+			const size_t length = std::strlen(texts.prefix);
+			if(id.compare(0, length, texts.prefix) != 0 || id.size() > length + 2)
+				continue;
+			const std::string suffix = id.substr(length);
+			if(!std::all_of(suffix.begin(), suffix.end(), [](char c) { return c >= '0' && c <= '9'; }))
+				break;
+			const int index = std::stoi(suffix) - texts.first;
+			if(index < 0 || index >= 8 || shownPlayerColors[index] == index)
+				break;
+			const TextIdentifier swapped(std::string(texts.prefix) + std::to_string(texts.first + shownPlayerColors[index]));
+			if(identifierExists(swapped))
+				return translateStringUnswapped(swapped);
+			break;
+		}
+	}
+	return translateStringUnswapped(identifier);
+}
