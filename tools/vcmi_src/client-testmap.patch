+
+// Files in <claude-bridge>/player/ (one JSON object per line in the .jsonl files):
+//   inbox.jsonl    Claude -> game: {"id": "...", "lines": ["move H1 12 14", "end"]} (or "cmd": "one line")
+//   outbox.jsonl   game -> Claude: {"ts", "kind", "color", "day", "text", "id"?, "ok"?}
+//                  kind: turn (briefing at turn start), reply (answer to an inbox request, same id),
+//                  handover (Claude was silent, the AI plays the rest), turn-end (summary of the turn)
+//   briefing.md    the latest turn briefing
+//   state.json     {"seats": [{"color", "name", "turn", "handedOver", "day", "secondsLeft"}], "updated"}
+//   config.json    optional {"timeout": 180, "idleTimeout": 20, "listenerFresh": 900}
+//   listener.json  touched by tools/vcmi_claude_player.py; if nobody touched it lately, nobody is
+//                  listening and the AI takes the turn after idleTimeout instead of timeout
+// Only inbox lines written after the game started count.
+
+namespace
+{
+using Clock = std::chrono::steady_clock;
+
+const char * const colorNames[] = {"红", "蓝", "棕", "绿", "橙", "紫", "青", "粉"};
+
+std::string colorName(PlayerColor color)
+{
+	return color.isValidPlayer() && color.getNum() < 8 ? colorNames[color.getNum()] : "中立";
+}
+
+std::string timestamp()
+{
+	std::time_t now = std::time(nullptr);
+	std::tm local{};
+#ifdef VCMI_WINDOWS
+	localtime_s(&local, &now);
+#else
+	localtime_r(&now, &local);
+#endif
+	char buffer[32];
+	std::strftime(buffer, sizeof(buffer), "%Y-%m-%dT%H:%M:%S", &local);
+	return buffer;
+}
+
+std::string jsonString(const std::string & value)
+{
+	std::string out = "\"";
+	for(unsigned char c : value)
+	{
+		if(c == '"' || c == '\\')
+			out += '\\', out += static_cast<char>(c);
+		else if(c == '\n')
+			out += "\\n";
+		else if(c < 0x20)
+			out += boost::str(boost::format("\\u%04x") % static_cast<int>(c));
+		else
+			out += static_cast<char>(c);
+	}
+	return out + "\"";
+}
+
+std::string pos(const int3 & p)
+{
+	return "(" + std::to_string(p.x) + "," + std::to_string(p.y) + "," + std::to_string(p.z) + ")";
+}
+
+/// hover texts and dialogs have line breaks and {colour} markup
+std::string oneLine(std::string text)
+{
+	boost::algorithm::replace_all(text, "\r", "");
+	boost::algorithm::replace_all(text, "{", "");
+	boost::algorithm::replace_all(text, "}", "");
+	std::vector<std::string> parts;
+	boost::split(parts, text, boost::is_any_of("\n"));
+	std::string out;
+	for(auto & part : parts)
+	{
+		boost::algorithm::trim(part);
+		if(part.empty())
+			continue;
+		if(!out.empty())
+			out += " · ";
+		out += part;
+	}
+	return out;
+}
+
+std::string lower(std::string s)
+{
+	boost::algorithm::to_lower(s);
+	return s;
+}
+
+bool isNumber(const std::string & s)
+{
+	return !s.empty() && std::all_of(s.begin(), s.end(), [](char c){ return c >= '0' && c <= '9'; });
+}
+
+/// "core:castle.tavern" -> "tavern"
+std::string shortKey(const std::string & key)
+{
+	const auto cut = key.find_last_of(".:");
+	return cut == std::string::npos ? key : key.substr(cut + 1);
+}
+
+std::string resourceName(int index)
+{
+	return LIBRARY->generaltexth->restypes[index];
+}
+
+const int resourceOrder[] = {GameResID::GOLD, GameResID::WOOD, GameResID::ORE, GameResID::MERCURY, GameResID::SULFUR, GameResID::CRYSTAL, GameResID::GEMS};
+
+std::string costText(const TResources & cost)
+{
+	std::string out;
+	for(int r : resourceOrder)
+	{
+		if(cost[r] == 0)
+			continue;
+		if(!out.empty())
+			out += "，";
+		out += resourceName(r) + " " + std::to_string(cost[r]);
+	}
+	return out.empty() ? "免费" : out;
+}
+
+std::string missingText(const TResources & cost, const TResources & have)
+{
+	TResources missing;
+	for(int r : resourceOrder)
+		missing[r] = std::max<TResource>(0, cost[r] - have[r]);
+	return costText(missing);
+}
+
+int affordable(const TResources & cost, const TResources & have)
+{
+	int count = std::numeric_limits<int>::max();
+	for(int r : resourceOrder)
+		if(cost[r] > 0)
+			count = std::min<int>(count, static_cast<int>(have[r] / cost[r]));
+	return count == std::numeric_limits<int>::max() ? 9999 : count;
+}
+
+std::string armyText(const CCreatureSet & army)
+{
+	std::string out;
+	for(const auto & [slot, stack] : army.Slots())
+	{
+		const CCreature * c = stack->getCreature();
+		if(!out.empty())
+			out += "，";
+		out += (c ? c->getNamePluralTranslated() : std::string("?")) + "×" + std::to_string(stack->getCount());
+	}
+	return out.empty() ? "（空）" : out;
+}
+
+int creatureCount(const CCreatureSet & army, CreatureID id)
+{
+	int count = 0;
+	for(const auto & [slot, stack] : army.Slots())
+		if(stack->getCreatureID() == id)
+			count += stack->getCount();
+	return count;
+}
