+void ClaudePlayer::startTurn(Seat & seat)
+{
+	{
+		std::shared_lock gsLock(CGameState::mutex);
+		if(seat.turnQuery.getNum() >= 0)
+			seat.cb->selectionMade(0, seat.turnQuery); // accept the turn, as CPlayerInterface does
+	}
+	{
+		std::lock_guard lock(mx);
+		pendingQueries.clear();
+	}
+	const Config config = readConfig();
+	seat.myTurn = true;
+	seat.handedOver = false;
+	seat.actionList.clear();
+	seat.timeout = listenerAlive(config) ? config.timeout : std::min(config.timeout, config.idleTimeout);
+
+	std::string text;
+	{
+		std::shared_lock gsLock(CGameState::mutex);
+		const auto & gs = client->gameState();
+		Snapshot now = takeSnapshot(gs, seat);
+		std::vector<std::string> changes;
+		if(seat.lastTurnEnd)
+			changes = diffSnapshots(gs, seat, *seat.lastTurnEnd, now);
+		{
+			std::lock_guard lock(mx);
+			changes.insert(changes.end(), seat.events.begin(), seat.events.end());
+			seat.events.clear();
+		}
+		text = briefing(gs, seat, changes, true);
+		seat.turnStart = now;
+	}
+	writeAtomic(playerDir() / "briefing.md", text);
+	post(seat, "turn", text);
+	seat.lastActivity = Clock::now();
+	logGlobal->info("Claude player: turn of %s, day %d, %d s to answer", seat.color.toString(), seat.cb->getDate(Date::DAY), seat.timeout);
+	writeState();
+}
+
+void ClaudePlayer::finishTurn(Seat & seat)
+{
+	if(!seat.myTurn)
+		return;
+	seat.myTurn = false;
+	std::string text;
+	{
+		std::shared_lock gsLock(CGameState::mutex);
+		const auto & gs = client->gameState();
+		Snapshot end = takeSnapshot(gs, seat);
+		text = colorName(seat.color) + "（" + seat.name + "）第 " + std::to_string(end.day) + " 天的回合结束了" + (seat.handedOver ? "（后半段是电脑替你打的）" : "") + "。这回合：\n";
+		std::vector<std::string> changes;
+		if(seat.turnStart)
+			changes = diffSnapshots(gs, seat, *seat.turnStart, end);
+		if(changes.empty())
+			text += "- 什么都没变\n";
+		for(const auto & line : changes)
+			text += "- " + line + "\n";
+		seat.lastTurnEnd = end;
+	}
+	{
+		std::lock_guard lock(mx);
+		seat.events.clear(); // things that happened during our own turn were reported with the commands
+	}
+	post(seat, "turn-end", text);
+	writeState();
+	turnSummary = text;
+}
+
+void ClaudePlayer::handOver(Seat & seat, const std::string & reason)
+{
+	seat.handedOver = true;
+	const std::string text = reason + "，这回合剩下的交给电脑打完。";
+	logGlobal->info("Claude player: %s: %s", seat.color.toString(), text);
+	post(seat, "handover", text);
+	writeState();
+	seat.standIn->yourTurn(QueryID(-1)); // QueryID -1: the turn was already accepted
+}
