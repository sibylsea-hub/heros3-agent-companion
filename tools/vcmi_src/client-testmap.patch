+
+void ClaudePlayer::attach(CClient & newClient, PlayerColor color, std::shared_ptr<CGameInterface> standIn)
+{
+	auto seat = std::make_shared<Seat>();
+	seat->color = color;
+	seat->name = newClient.gameState().getStartInfo()->playerInfos.at(color).name;
+	seat->cb = std::make_shared<CCallback>(newClient.gameStatePtr(), color, &newClient);
+	seat->cb->waitTillRealize = true;
+	seat->standIn = standIn;
+	seat->timeout = readConfig().timeout;
+
+	bool start = false;
+	{
+		std::lock_guard lock(mx);
+		if(client != &newClient)
+		{
+			seats.clear();
+			pendingQueries.clear();
+		}
+		client = &newClient;
+		seats[color] = seat;
+		start = !worker.joinable();
+		if(start)
+		{
+			boost::system::error_code ec;
+			const auto inbox = playerDir() / "inbox.jsonl";
+			inboxOffset = boost::filesystem::exists(inbox, ec) ? boost::filesystem::file_size(inbox, ec) : 0;
+		}
+	}
+	logGlobal->info("Claude player: %s (%s) is played by Claude, the stand-in AI takes over when Claude is silent", color.toString(), seat->name);
+	if(start)
+	{
+		stopping = false;
+		worker = std::thread([this]() { run(); });
+	}
+	writeState();
+}
+
+void ClaudePlayer::detach()
+{
+	stopping = true;
+	if(worker.joinable())
+		worker.join();
+	bool hadSeats = false;
+	{
+		std::lock_guard lock(mx);
+		hadSeats = !seats.empty();
+		seats.clear();
+		pendingQueries.clear();
+		client = nullptr;
+		stopping = false;
+	}
+	if(hadSeats)
+		writeState(); // no seats: the game is over, nobody waits for Claude
+}
+
+bool ClaudePlayer::controls(PlayerColor color) const
+{
+	std::lock_guard lock(mx);
+	return seats.count(color);
+}
