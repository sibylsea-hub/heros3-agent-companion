+void ClaudePlayer::pollInbox()
+{
+	const auto inbox = playerDir() / "inbox.jsonl";
+	boost::system::error_code ec;
+	if(!boost::filesystem::exists(inbox, ec))
+		return;
+	const uintmax_t size = boost::filesystem::file_size(inbox, ec);
+	if(ec)
+		return;
+	if(size < inboxOffset)
+		inboxOffset = 0; // truncated or replaced
+	if(size == inboxOffset)
+		return;
+	std::ifstream in(inbox.c_str(), std::ios::binary);
+	in.seekg(static_cast<std::streamoff>(inboxOffset));
+	std::string chunk(static_cast<size_t>(size - inboxOffset), '\0');
+	in.read(chunk.data(), chunk.size());
+	chunk.resize(static_cast<size_t>(in.gcount()));
+	const size_t complete = chunk.rfind('\n'); // a half-written last line waits for the next round
+	if(complete == std::string::npos)
+		return;
+	inboxOffset += complete + 1;
+	std::istringstream stream(chunk.substr(0, complete));
+	for(std::string line; std::getline(stream, line);)
+	{
+		boost::algorithm::trim(line);
+		if(!line.empty())
+			handleRequest(line);
+	}
+}
+
+void ClaudePlayer::handleRequest(const std::string & line)
+{
+	std::string id;
+	std::string color;
+	std::vector<std::string> commands;
+	try
+	{
+		const JsonNode request(line.data(), line.size(), "claude-bridge/player/inbox.jsonl");
+		id = request["id"].isString() ? request["id"].String() : "";
+		color = request["color"].isString() ? request["color"].String() : "";
+		if(request["cmd"].isString())
+			commands.push_back(request["cmd"].String());
+		for(const auto & item : request["lines"].Vector())
+			if(item.isString())
+				commands.push_back(item.String());
+	}
+	catch(const std::exception & e)
+	{
+		logGlobal->error("Claude player: bad inbox line %s: %s", line, e.what());
+		return;
+	}
+
+	auto seat = seatFor(color);
+	if(!seat)
+	{
+		appendLine(playerDir() / "outbox.jsonl", "{\"ts\": " + jsonString(timestamp()) + ", \"kind\": \"reply\", \"id\": " + jsonString(id)
+			+ ", \"ok\": false, \"text\": " + jsonString("这局游戏里没有 Claude 的座位" + (color.empty() ? std::string() : "（颜色 " + color + "）")) + "}");
+		return;
+	}
+	seat->lastActivity = Clock::now();
+	if(seat->myTurn && !seat->handedOver)
+		seat->timeout = std::max(seat->timeout, readConfig().timeout); // someone answers after all: full time
+
+	std::string out;
+	bool allOk = true;
+	bool turnOver = false;
+	for(const auto & command : commands)
+	{
+		if(!allOk || turnOver)
+		{
+			out += "· 没执行：" + command + (turnOver ? "（回合已经结束）" : "（前面的命令没成功）") + "\n";
+			continue;
+		}
+		bool ok = true;
+		std::string result;
+		{
+			std::lock_guard lock(mx);
+			seat->commandRunning = true;
+			seat->commandEvents.clear();
+		}
+		try
+		{
+			result = execute(*seat, command, ok, turnOver);
+		}
+		catch(const Refused & e)
+		{
+			ok = false;
+			result = std::string("不行：") + e.what();
+		}
+		std::vector<std::string> events;
+		{
+			std::lock_guard lock(mx);
+			seat->commandRunning = false;
+			std::swap(events, seat->commandEvents);
+		}
+		out += "> " + command + "\n" + result + "\n";
+		for(const auto & event : events)
+			out += "  · " + event + "\n";
+		allOk = allOk && ok;
+	}
+	if(commands.empty())
+	{
+		out = "没收到命令。" + commandHelp();
+		allOk = false;
+	}
+	seat->lastActivity = Clock::now();
+	post(*seat, "reply", out, id, allOk);
+	writeState();
+}
+
+bool ClaudePlayer::waitQuiet(Seat & seat, std::shared_lock<std::shared_mutex> & gsLock)
+{
+	gsLock.unlock();
+	const auto start = Clock::now();
+	int quiet = 0;
+	bool ok = true;
+	for(;;)
+	{
+		if(stopping)
+		{
+			gsLock.lock();
+			throw TerminationRequestedException();
+		}
+		bool battle;
+		{
+			std::shared_lock lock(CGameState::mutex);
+			battle = client->gameState().getBattle(seat.color) != nullptr;
+		}
+		bool queries;
+		{
+			std::lock_guard lock(mx);
+			queries = !pendingQueries.empty();
+		}
+		if(!battle && !queries)
+		{
+			if(++quiet >= 3)
+				break;
+		}
+		else
+			quiet = 0;
+		if(!battle && Clock::now() - start > std::chrono::seconds(30))
+		{
+			ok = false; // a dialog nobody answers; go on anyway
+			std::lock_guard lock(mx);
+			pendingQueries.clear();
+			break;
+		}
+		std::this_thread::sleep_for(std::chrono::milliseconds(50));
+	}
+	gsLock.lock();
+	return ok;
+}
+
+std::string ClaudePlayer::execute(Seat & seat, const std::string & command, bool & ok, bool & turnOver)
+{
+	const auto words = splitWords(command);
+	if(words.empty())
+		throw Refused("空命令");
+	const std::string verb = lower(words[0]);
+
+	if(isNumber(verb) || (verb == "do" && words.size() == 2 && isNumber(words[1])))
+	{
+		const size_t index = std::stoul(isNumber(verb) ? verb : words[1]);
+		if(index < 1 || index > seat.actionList.size())
+			throw Refused("没有第 " + std::to_string(index) + " 项（先发 actions 列一下）");
+		const std::string actual = seat.actionList[index - 1];
+		return "（第 " + std::to_string(index) + " 项：" + actual + "）\n" + execute(seat, actual, ok, turnOver);
+	}
+
+	if(verb == "help")
+		return commandHelp();
+
+	if(verb == "status")
+	{
+		std::shared_lock gsLock(CGameState::mutex);
+		const auto & gs = client->gameState();
+		std::string acting;
+		for(const auto & color : gs.actingPlayers)
+			acting += (acting.empty() ? "" : "、") + playerLabel(gs, color);
+		std::string text = dateText(*seat.cb) + "，现在行动的是：" + (acting.empty() ? std::string("没人") : acting) + "。";
+		if(seat.myTurn && !seat.handedOver)
+		{
+			const auto left = seat.timeout - std::chrono::duration_cast<std::chrono::seconds>(Clock::now() - seat.lastActivity).count();
+			text += "轮到你了，还剩 " + std::to_string(std::max<long long>(0, left)) + " 秒（每条命令都会重新计时）。";
+		}
+		else if(seat.myTurn)
+			text += "这回合已经交给电脑了。";
+		else
+			text += "还没轮到你。";
+		return text;
+	}
+
+	if(verb == "brief" || verb == "briefing")
+	{
+		std::shared_lock gsLock(CGameState::mutex);
+		return briefing(client->gameState(), seat, {}, false);
+	}
+
+	if(verb == "actions")
+	{
+		std::shared_lock gsLock(CGameState::mutex);
+		if(!seat.myTurn || seat.handedOver)
+			throw Refused("现在不是你的回合");
+		return actionsText(client->gameState(), seat);
+	}
+
+	if(verb == "say")
+	{
+		const std::string text = command.substr(command.find(words[0]) + words[0].size());
+		std::string trimmed = boost::algorithm::trim_copy(text);
+		if(trimmed.empty())
+			throw Refused("say 后面要跟要说的话");
+		const std::string from = seat.name;
+		ENGINE->dispatchMainThread([from, trimmed]()
+		{
+			if(GAME->server().client)
+				GAME->server().getGameChat().getClaudeBridge().showLine(from, trimmed);
+		});
+		return "已经说到游戏里了（" + from + "）：" + trimmed;
+	}
+
+	if(verb == "screenshot")
+	{
+		// tests only: it captures the whole game screen and announces the file in the game chat
+		if(!std::getenv("VCMI_CLAUDE_PLAYER_DEV"))
+			throw Refused("screenshot 只在测试客户端里能用（VCMI_CLAUDE_PLAYER_DEV）");
+		ENGINE->dispatchMainThread([]() { ENGINE->screenHandler().screenShot(); });
+		return "截图存到 " + (VCMIDirs::get().userExtractedPath() / "screenshots").string() + "（最新的那张）";
+	}
+
+	// everything below acts in the game
+	if(verb != "move" && verb != "build" && verb != "recruit" && verb != "hire" && verb != "end")
+		throw Refused("不认识的命令 " + words[0] + "。" + commandHelp());
+	if(!seat.myTurn)
+		throw Refused("现在不是你的回合");
+	if(seat.handedOver)
+		throw Refused("这回合已经交给电脑了，等下一回合");
+
+	std::shared_lock gsLock(CGameState::mutex);
+	auto & cb = *seat.cb;
+
+	if(verb == "end")
+	{
+		cb.endTurn();
+		gsLock.unlock();
+		const auto start = Clock::now();
+		bool ended = false;
+		while(!ended && Clock::now() - start < std::chrono::seconds(15))
+		{
+			{
+				std::lock_guard lock(mx);
+				ended = seat.turnEnded;
+				seat.turnEnded = false;
+			}
+			if(!ended)
+				std::this_thread::sleep_for(std::chrono::milliseconds(50));
+		}
+		gsLock.lock();
+		if(!ended)
+		{
+			ok = false;
+			return "服务器还没结束这回合（可能有对话框或战斗没完）";
+		}
+		gsLock.unlock();
+		finishTurn(seat);
+		gsLock.lock();
+		turnOver = true;
+		return turnSummary;
+	}
+
+	if(verb == "move")
+	{
+		if(words.size() < 4)
+			throw Refused("用法：move H1 x y [z]");
+		const auto * hero = findHero(seat, words[1]);
+		if(!isNumber(words[2]) || !isNumber(words[3]) || (words.size() > 4 && !isNumber(words[4])))
+			throw Refused("坐标要写数字：move H1 x y [z]");
+		const int3 dst(std::stoi(words[2]), std::stoi(words[3]), words.size() > 4 ? std::stoi(words[4]) : hero->visitablePos().z);
+		if(!cb.isInTheMap(dst))
+			throw Refused(pos(dst) + " 不在地图里");
+		if(hero->isGarrisoned())
+			throw Refused(hero->getNameTranslated() + " 在城里驻守，先换成来访英雄才能出门");
+		const ObjectInstanceID heroID = hero->id;
+		const int3 start = hero->visitablePos();
+		const std::string name = hero->getNameTranslated();
+
+		auto current = [&]() -> const CGHeroInstance *
+		{
+			const auto * h = cb.getHero(heroID);
+			return h && h->getOwner() == seat.color ? h : nullptr;
+		};
+
+		std::string note;
+		if(start == dst)
+		{
+			// visit the object we stand on again
+			cb.moveHero(hero, hero->convertFromVisitablePos(dst), false);
+			waitQuiet(seat, gsLock);
+			note = "原地又拜访了一次";
+		}
+		else
+		{
+			if(!cb.isVisible(dst))
+				throw Refused(pos(dst) + " 还在迷雾里，看不见的地方不能当目的地");
+			if(hero->movementPointsRemaining() == 0)
+				throw Refused(name + " 今天没有行动力了");
+			for(int step = 0; step < 300; ++step)
+			{
+				const auto * h = current();
+				if(!h)
+					break;
+				if(h->visitablePos() == dst)
+					break;
+				PathfinderCache cache(&cb, PathfinderOptions(cb));
+				auto paths = cache.getPathsInfo(h);
+				CGPath path;
+				if(!paths->getPath(path, dst) || path.nodes.size() < 2)
+				{
+					if(step == 0)
+						throw Refused(name + " 走不到 " + pos(dst) + "（被挡住了，或者要坐船、要先打开路）");
+					note = "后面的路走不通了";
+					break;
+				}
+				const auto & next = path.nextNode();
+				if(next.turns > 0)
+				{
+					if(step == 0)
+						throw Refused(name + " 今天的行动力不够走下一步，到 " + pos(dst) + " 还要 " + std::to_string(path.lastNode().turns) + " 天");
+					note = "今天的行动力用完了，到 " + pos(dst) + " 还要 " + std::to_string(path.lastNode().turns) + " 天";
+					break;
+				}
+				const int3 before = h->visitablePos();
+				if(next.isTeleportAction())
+					cb.moveHero(h, h->pos, false);
+				else
+					cb.moveHero(h, h->convertFromVisitablePos(next.coord), next.layer == EPathfindingLayer::AIR || next.layer == EPathfindingLayer::WATER);
+				const bool battleOrDialog = next.action == EPathNodeAction::BATTLE || next.action == EPathNodeAction::TELEPORT_BATTLE;
+				waitQuiet(seat, gsLock);
+				const auto * after = current();
+				if(!after)
+					break;
+				if(next.coord == dst && after->visitablePos() != dst)
+				{
+					// blocking objects (resources, chests, monsters, dwellings...) are visited from next door
+					note = battleOrDialog ? "和目的地上的守军打了一仗" : "在旁边一格拜访了目的地";
+					break;
+				}
+				if(after->visitablePos() == before && !next.isTeleportAction())
+				{
+					note = "走不动了，停在 " + pos(before);
+					break;
+				}
+				if(battleOrDialog && after->visitablePos() != dst)
+				{
+					note = "途中打了一仗，先停在这里";
+					break;
+				}
+			}
+		}
+		const auto * h = current();
+		if(!h)
+			return name + " 不在了（战死了或者被俘了）";
+		std::string text = name + " 从 " + pos(start) + " 到了 " + pos(h->visitablePos()) + "，剩 " + std::to_string(h->movementPointsRemaining()) + " 行动力";
+		if(h->visitablePos() == dst)
+			text += "，到达目的地";
+		if(!note.empty())
+			text += "；" + note;
+		text += "。兵：" + armyText(*h);
+		return text;
+	}
+
+	if(verb == "build")
+	{
+		if(words.size() < 3)
+			throw Refused("用法：build T1 <建筑>（brief 里方括号里是建筑代号）");
+		const auto * town = findTown(seat, words[1]);
+		const BuildingID building = findBuilding(town, joinFrom(words, 2));
+		const auto state = cb.canBuildStructure(town, building);
+		const std::string name = buildingName(town, building);
+		const auto & cost = town->getTown()->buildings.at(building)->resources;
+		if(state == EBuildingState::NO_RESOURCES)
+			throw Refused(name + " 要 " + costText(cost) + "，还差 " + missingText(cost, cb.getResourceAmount()));
+		if(state == EBuildingState::PREREQUIRES || state == EBuildingState::MISSING_BASE)
+		{
+			auto needed = town->genBuildingRequirements(building).getFulfillmentCandidates([town](const BuildingID & id) { return town->hasBuilt(id); });
+			std::string list;
+			for(const auto & id : needed)
+				if(!buildingName(town, id).empty())
+					list += (list.empty() ? "" : "、") + buildingName(town, id);
+			throw Refused(name + "：" + buildingStateText(state) + (list.empty() ? "" : "，要先建：" + list));
+		}
+		if(state != EBuildingState::ALLOWED)
+			throw Refused(name + "：" + buildingStateText(state));
+		const ObjectInstanceID townID = town->id;
+		cb.buildBuilding(town, building);
+		waitQuiet(seat, gsLock);
+		const auto * after = cb.getTown(townID);
+		if(!after || !after->hasBuilt(building))
+		{
+			ok = false;
+			return "服务器没同意建 " + name;
+		}
+		return after->getNameTranslated() + " 建好了 " + name + "，花了 " + costText(cost);
+	}
+
+	if(verb == "recruit")
+	{
+		if(words.size() < 3)
+			throw Refused("用法：recruit T1 <兵种> [数量|max]");
+		const auto * town = findTown(seat, words[1]);
+		std::string countWord = words.size() > 3 ? lower(words.back()) : "max";
+		const std::string creatureKey = words.size() > 3 ? joinFrom(std::vector<std::string>(words.begin(), words.end() - 1), 2) : words[2];
+		std::optional<RecruitOption> chosen;
+		std::string offered;
+		for(const auto & option : recruitOptions(town))
+		{
+			const auto * c = option.creature.toCreature();
+			offered += (offered.empty() ? "" : "、") + c->getNamePluralTranslated() + "[" + shortKey(c->getJsonKey()) + "]";
+			if(boost::algorithm::iequals(shortKey(c->getJsonKey()), creatureKey) || boost::algorithm::iequals(c->getJsonKey(), creatureKey)
+				|| c->getNamePluralTranslated() == creatureKey || c->getNameSingularTranslated() == creatureKey
+				|| (isNumber(creatureKey) && option.creature.getNum() == std::stoi(creatureKey)))
+				chosen = option;
+		}
+		if(!chosen)
+			throw Refused(town->getNameTranslated() + " 招不到 " + creatureKey + "（能招的：" + (offered.empty() ? std::string("没有") : offered) + "）");
+		const auto * c = chosen->creature.toCreature();
+		const auto cost = c->getFullRecruitCost();
+		const auto res = cb.getResourceAmount();
+		if(chosen->available <= 0)
+			throw Refused(c->getNamePluralTranslated() + " 这周已经招完了");
+		const int canPay = affordable(cost, res);
+		int amount;
+		if(countWord == "max" || countWord == "all")
+			amount = std::min(chosen->available, canPay);
+		else if(isNumber(countWord))
+			amount = std::stoi(countWord);
+		else
+			throw Refused("数量要写数字或 max");
+		std::string note;
+		if(amount > chosen->available)
+		{
+			note = "（只有 " + std::to_string(chosen->available) + " 只）";
+			amount = chosen->available;
+		}
+		if(amount <= 0)
+			throw Refused("钱不够：每只 " + costText(cost));
+		if(amount > canPay)
+			throw Refused(std::to_string(amount) + " 只要 " + costText(cost * amount) + "，钱不够，最多买 " + std::to_string(canPay) + " 只");
+
+		const CArmedInstance * dst = nullptr;
+		for(const CArmedInstance * candidate : {static_cast<const CArmedInstance *>(town->getVisitingHero()), static_cast<const CArmedInstance *>(town->getGarrisonHero())})
+			if(!dst && candidate && candidate->getSlotFor(c).validSlot())
+				dst = candidate;
+		if(!dst && !town->getGarrisonHero() && town->getSlotFor(c).validSlot())
+			dst = town;
+		if(!dst)
+			throw Refused("城里和英雄身上都没有空位放 " + c->getNamePluralTranslated() + "（七个格子都满了）");
+		const ObjectInstanceID dstID = dst->id;
+		const std::string dstName = dst == town ? town->getNameTranslated() + " 的驻军" : dynamic_cast<const CGHeroInstance *>(dst)->getNameTranslated();
+		const int before = creatureCount(*dst, chosen->creature);
+		cb.recruitCreatures(town, dst, chosen->creature, amount, chosen->level);
+		waitQuiet(seat, gsLock);
+		const auto * after = dynamic_cast<const CArmedInstance *>(cb.getObj(dstID, false));
+		const int got = after ? creatureCount(*after, chosen->creature) - before : 0;
+		if(got <= 0)
+		{
+			ok = false;
+			return "服务器没同意招兵";
+		}
+		return "招了 " + std::to_string(got) + " 只 " + c->getNamePluralTranslated() + note + "，进了 " + dstName + "，花了 " + costText(cost * got);
+	}
+
+	if(verb == "hire")
+	{
+		if(words.size() < 2)
+			throw Refused("用法：hire T1 [1|2|英雄名]");
+		const auto * town = findTown(seat, words[1]);
+		if(!town->hasBuilt(BuildingID::TAVERN))
+			throw Refused(town->getNameTranslated() + " 还没有酒馆");
+		if(town->getVisitingHero())
+			throw Refused(town->getNameTranslated() + " 门口有来访英雄 " + town->getVisitingHero()->getNameTranslated() + "，新英雄没地方站，先把他移开");
+		if(cb.getResourceAmount(GameResID::GOLD) < GameConstants::HERO_GOLD_COST)
+			throw Refused("招英雄要 " + std::to_string(GameConstants::HERO_GOLD_COST) + " 金币");
+		const auto available = cb.getAvailableHeroes(town);
+		if(available.empty())
+			throw Refused("酒馆里没有英雄");
+		const CGHeroInstance * chosen = nullptr;
+		const std::string key = words.size() > 2 ? joinFrom(words, 2) : "1";
+		if(isNumber(key) && std::stoul(key) >= 1 && std::stoul(key) <= available.size())
+			chosen = available[std::stoul(key) - 1];
+		for(const auto * h : available)
+			if(!chosen && h->getNameTranslated() == key)
+				chosen = h;
+		if(!chosen)
+			throw Refused("酒馆里没有 " + key);
+		const std::string name = chosen->getNameTranslated();
+		const size_t before = cb.getHeroesInfo().size();
+		cb.recruitHero(town, chosen);
+		waitQuiet(seat, gsLock);
+		const auto heroes = cb.getHeroesInfo();
+		if(heroes.size() <= before)
+		{
+			ok = false;
+			return "服务器没同意招 " + name;
+		}
+		for(size_t i = 0; i < heroes.size(); ++i)
+			if(heroes[i]->getNameTranslated() == name)
+				return "招到了 " + heroLine(heroes[i], static_cast<int>(i + 1));
+		return "招到了 " + name;
+	}
+
+	throw Refused("不认识的命令 " + words[0]);
+}
+
+void ClaudePlayer::writeState()
+{
+	std::vector<std::shared_ptr<Seat>> list;
+	{
+		std::lock_guard lock(mx);
+		for(auto & [color, seat] : seats)
+			list.push_back(seat);
+	}
+	std::string text = "{\n  \"updated\": " + jsonString(timestamp()) + ",\n  \"seats\": [";
+	bool first = true;
+	for(const auto & seat : list)
+	{
+		long long left = 0;
+		if(seat->myTurn && !seat->handedOver)
+			left = std::max<long long>(0, seat->timeout - std::chrono::duration_cast<std::chrono::seconds>(Clock::now() - seat->lastActivity).count());
+		text += std::string(first ? "" : ",") + "\n    {\"color\": " + jsonString(seat->color.toString()) + ", \"name\": " + jsonString(seat->name)
+			+ ", \"turn\": " + (seat->myTurn ? "true" : "false") + ", \"handedOver\": " + (seat->handedOver ? "true" : "false")
+			+ ", \"day\": " + std::to_string(seat->cb->getDate(Date::DAY)) + ", \"timeout\": " + std::to_string(seat->timeout)
+			+ ", \"secondsLeft\": " + std::to_string(left) + "}";
+		first = false;
+	}
+	text += "\n  ]\n}\n";
+	writeAtomic(playerDir() / "state.json", text);
+}
