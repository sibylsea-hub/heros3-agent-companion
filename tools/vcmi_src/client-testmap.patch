+struct Destination
+{
+	const CGObjectInstance * object;
+	int turns;
+	int moveRemains;
+};
+
+/// interesting visible objects a hero reaches within `maxTurns` more days, nearest first
+std::vector<Destination> destinations(const Seat & seat, const CGHeroInstance * hero, int maxTurns)
+{
+	PathfinderCache cache(seat.cb.get(), PathfinderOptions(*seat.cb));
+	auto paths = cache.getPathsInfo(hero);
+	std::vector<Destination> out;
+	for(const auto * obj : seat.cb->getAllVisitableObjs())
+	{
+		if(obj == hero || obj->visitablePos() == hero->visitablePos())
+			continue;
+		if(obj->getOwner() == seat.color && obj->ID != Obj::TOWN && obj->ID != Obj::HERO)
+			continue; // our own mines and dwellings
+		if(obj->ID == Obj::HERO && obj->getOwner() == seat.color)
+			continue;
+		const auto * node = paths->getPathInfo(obj->visitablePos());
+		if(!node || !node->reachable() || node->turns > maxTurns)
+			continue;
+		out.push_back({obj, node->turns, node->moveRemains});
+	}
+	std::sort(out.begin(), out.end(), [](const Destination & a, const Destination & b)
+	{
+		return a.turns != b.turns ? a.turns < b.turns : a.moveRemains > b.moveRemains;
+	});
+	return out;
+}
