+std::string timestamp()
+{
+	std::time_t now = std::time(nullptr);
+	std::tm local{};
+#ifdef VCMI_WINDOWS
+	localtime_s(&local, &now);
+#else
+	localtime_r(&now, &local);
+#endif
+	char buffer[32];
+	std::strftime(buffer, sizeof(buffer), "%Y-%m-%dT%H:%M:%S", &local);
+	return buffer;
+}
+
+std::string jsonString(const std::string & value)
+{
+	std::string out = "\"";
+	for(unsigned char c : value)
+	{
+		if(c == '"' || c == '\\')
+			out += '\\', out += static_cast<char>(c);
+		else if(c == '\n')
+			out += "\\n";
+		else if(c < 0x20)
+			out += boost::str(boost::format("\\u%04x") % static_cast<int>(c));
+		else
+			out += static_cast<char>(c);
+	}
+	return out + "\"";
+}
+
+/// One JSON object per line (JsonNode's writer always breaks lines)
+std::string jsonLine(const std::string & from, const std::string & text, const std::string & kind)
+{
+	return "{\"ts\": " + jsonString(timestamp()) + ", \"from\": " + jsonString(from) + ", \"text\": " + jsonString(text)
+		+ ", \"kind\": " + jsonString(kind) + "}";
+}
+
+std::vector<std::string> splitLines(const std::string & data)
+{
+	std::vector<std::string> lines;
+	std::istringstream stream(data);
+	for(std::string line; std::getline(stream, line);)
+	{
+		boost::algorithm::trim(line);
+		if(!line.empty())
+			lines.push_back(line);
+	}
+	return lines;
+}
+
+std::string utf8(const boost::filesystem::path & path)
+{
+#ifdef VCMI_WINDOWS
+	return boost::locale::conv::utf_to_utf<char>(path.generic_wstring());
+#else
+	return path.generic_string();
+#endif
+}
+
+std::string urlEncode(const std::string & value)
+{
+	static const char * hex = "0123456789ABCDEF";
+	std::string out;
+	for(unsigned char c : value)
+	{
+		const bool plain = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '/';
+		if(plain)
+			out += static_cast<char>(c);
+		else
+		{
+			out += '%';
+			out += hex[c >> 4];
+			out += hex[c & 15];
+		}
+	}
+	return out;
+}
+
+std::string readFile(const boost::filesystem::path & path)
+{
+	std::ifstream in(path.c_str(), std::ios::binary);
+	return std::string(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+}
+
+std::string playerName()
+{
+	try
+	{
+		if(GAME->interface() && GAME->interface()->cb)
+			return GAME->interface()->cb->getStartInfo()->playerInfos.at(GAME->interface()->playerID).name;
+	}
+	catch(const std::out_of_range &)
+	{
+		// spectator or no player yet
+	}
+	return "玩家";
+}
+
+std::map<boost::filesystem::path, std::time_t> scanSaves(const boost::filesystem::path & root)
+{
+	std::map<boost::filesystem::path, std::time_t> result;
+	boost::system::error_code ec;
+	for(boost::filesystem::recursive_directory_iterator it(root, ec), end; !ec && it != end; it.increment(ec))
+	{
+		if(boost::algorithm::iequals(it->path().extension().string(), ".vsgm1"))
+		{
+			boost::system::error_code timeError;
+			const std::time_t time = boost::filesystem::last_write_time(it->path(), timeError);
+			if(!timeError)
+				result[it->path()] = time;
+		}
+	}
+	return result;
+}
+}
+
+ClaudeBridge::ClaudeBridge()
+{
+	// the key the server wants on host commands; a new one only when the file is missing
+	const auto keyFile = directory() / "host-key.txt";
+	try
+	{
+		if(boost::filesystem::exists(keyFile))
+		{
+			std::ifstream in(keyFile.c_str());
+			in >> hostKey;
+		}
+		if(hostKey.empty())
+		{
+			std::random_device random;
+			for(int i = 0; i < 4; ++i)
+				hostKey += boost::str(boost::format("%08x") % random());
+			boost::filesystem::create_directories(directory());
+			std::ofstream(keyFile.c_str()) << hostKey << "\n";
+		}
+	}
+	catch(const std::exception & e)
+	{
+		logGlobal->error("Claude bridge: no host key: %s", e.what());
+	}
+	thread = std::thread([this]() { run(); });
+}
+
+ClaudeBridge::~ClaudeBridge()
+{
+	stopping = true;
+	if(thread.joinable())
+		thread.join();
+}
+
+boost::filesystem::path ClaudeBridge::directory()
+{
+	if(const char * dir = std::getenv("VCMI_CLAUDE_BRIDGE"))
+		return boost::filesystem::path(dir);
+	return VCMIDirs::get().userDataPath() / "claude-bridge";
+}
+
+void ClaudeBridge::run()
+{
+	setThreadName("claudeBridge");
+	const auto configPath = directory() / "config.json";
+	boost::system::error_code ec;
+	if(boost::filesystem::exists(configPath, ec))
+	{
+		std::string url;
+		std::string token;
+		try
+		{
+			const std::string data = readFile(configPath);
+			const JsonNode config(data.data(), data.size(), "claude-bridge/config.json");
+			url = config["relay"].isString() ? config["relay"].String() : "";
+			token = config["token"].isString() ? config["token"].String() : "";
+		}
+		catch(const std::exception & e)
+		{
+			logGlobal->error("Claude bridge: cannot read %s: %s", configPath.string(), e.what());
+		}
+		if(!url.empty())
+		{
+			if(boost::algorithm::starts_with(url, "http://"))
+				url = url.substr(7);
+			url = url.substr(0, url.find('/'));
+			const auto colon = url.rfind(':');
+			Relay relay;
+			relay.host = url.substr(0, colon);
+			relay.port = colon == std::string::npos ? "8733" : url.substr(colon + 1);
+			relay.token = token;
+			runRelay(relay);
+			return;
+		}
+	}
+	runFiles();
+}
+
+void ClaudeBridge::runFiles()
+{
+	setLink(ELink::FILES, "本机直连");
+	const auto dir = directory();
+	const auto inbox = dir / "to-game.jsonl";
+	boost::system::error_code ec;
+	// only messages written after the client started count
+	uintmax_t offset = boost::filesystem::exists(inbox, ec) ? boost::filesystem::file_size(inbox, ec) : 0;
+
+	auto flushOutbox = [&]()
+	{
+		std::deque<std::string> lines;
+		{
+			std::lock_guard lock(mutex);
+			std::swap(lines, outbox);
+		}
+		if(lines.empty())
+			return;
+		boost::filesystem::create_directories(dir, ec);
+		std::ofstream out((dir / "from-game.jsonl").c_str(), std::ios::binary | std::ios::app);
+		for(const auto & line : lines)
+			out << line << '\n';
+	};
+
+	while(sleepFor(std::chrono::milliseconds(300)))
+	{
+		std::vector<std::string> lines;
+		if(boost::filesystem::exists(inbox, ec))
+		{
+			const uintmax_t size = boost::filesystem::file_size(inbox, ec);
+			if(!ec)
+			{
+				if(size < offset)
+					offset = 0; // file was truncated or replaced
+				if(size > offset)
+				{
+					std::ifstream in(inbox.c_str(), std::ios::binary);
+					in.seekg(static_cast<std::streamoff>(offset));
+					std::string chunk(static_cast<size_t>(size - offset), '\0');
+					in.read(chunk.data(), chunk.size());
+					chunk.resize(static_cast<size_t>(in.gcount()));
+					const size_t complete = chunk.rfind('\n'); // leave a half-written last line for later
+					if(complete != std::string::npos)
+					{
+						offset += complete + 1;
+						lines = splitLines(chunk.substr(0, complete));
+					}
+				}
+			}
+		}
+		flushOutbox();
+		dispatch(std::move(lines));
+
+		// tests only (tools/vcmi_dev_client.py, VCMI_CLAUDE_PLAYER_DEV): player/screenshot.request asks for a screenshot, also in menus
+		if(std::getenv("VCMI_CLAUDE_PLAYER_DEV") && boost::filesystem::exists(dir / "player" / "screenshot.request", ec))
+		{
+			boost::filesystem::remove(dir / "player" / "screenshot.request", ec);
+			if(ENGINE)
+				ENGINE->dispatchMainThread([]() { ENGINE->screenHandler().screenShot(); });
+		}
+		// tests only: player/ui.request, lines "click <x> <y>", clicks into the game window (the hidden test desktop has no mouse)
+		if(std::getenv("VCMI_CLAUDE_PLAYER_DEV") && boost::filesystem::exists(dir / "player" / "ui.request", ec))
+		{
+			const std::string requests = readFile(dir / "player" / "ui.request");
+			boost::filesystem::remove(dir / "player" / "ui.request", ec);
+			for(const auto & line : splitLines(requests))
+			{
+				int x = 0;
+				int y = 0;
+				if(std::sscanf(line.c_str(), "click %d %d", &x, &y) != 2)
+					continue;
+				SDL_Event event{};
+				event.type = SDL_MOUSEMOTION;
+				event.motion.x = x;
+				event.motion.y = y;
+				SDL_PushEvent(&event);
+				for(const Uint32 type : {SDL_MOUSEBUTTONDOWN, SDL_MOUSEBUTTONUP})
+				{
+					event = {};
+					event.type = type;
+					event.button.button = SDL_BUTTON_LEFT;
+					event.button.state = type == SDL_MOUSEBUTTONDOWN ? SDL_PRESSED : SDL_RELEASED;
+					event.button.clicks = 1;
+					event.button.x = x;
+					event.button.y = y;
+					SDL_PushEvent(&event);
+					std::this_thread::sleep_for(std::chrono::milliseconds(80));
+				}
+				std::this_thread::sleep_for(std::chrono::milliseconds(300));
+			}
+		}
+	}
+	flushOutbox();
+}
+
+static http::response<http::string_body> relayRequest(const std::string & host, const std::string & port, const std::string & token, http::verb verb, const std::string & target, std::string body = {})
+{
+	boost::asio::io_context io;
+	tcp::resolver resolver(io);
+	beast::tcp_stream stream(io);
+	stream.expires_after(std::chrono::seconds(30));
+	stream.connect(resolver.resolve(host, port));
+
+	http::request<http::string_body> request(verb, target, 11);
+	request.set(http::field::host, host);
+	request.set("X-Bridge-Token", token);
+	if(verb != http::verb::get)
+	{
+		request.set(http::field::content_type, "application/octet-stream");
+		request.body() = std::move(body);
+	}
+	request.prepare_payload();
+	http::write(stream, request);
+
+	beast::flat_buffer buffer;
+	http::response_parser<http::string_body> parser;
+	parser.body_limit(16 * 1024 * 1024);
+	http::read(stream, buffer, parser);
+	beast::error_code ec;
+	stream.socket().shutdown(tcp::socket::shutdown_both, ec);
+
+	auto response = parser.release();
+	if(response.result() != http::status::ok)
+		throw std::runtime_error("HTTP " + std::to_string(response.result_int()) + " " + response.body());
+	return response;
+}
+
+void ClaudeBridge::runRelay(const Relay & relay)
+{
+	setLink(ELink::CONNECTING, "正在连接电脑 " + relay.host);
+	auto send = [&relay](http::verb verb, const std::string & target, std::string body = {})
+	{
+		return relayRequest(relay.host, relay.port, relay.token, verb, target, std::move(body));
+	};
+
+	const auto saveRoot = VCMIDirs::get().userSavePath();
+	auto uploaded = scanSaves(saveRoot); // saves made before this run are old news
+	auto nextSaveScan = std::chrono::steady_clock::now();
+	int64_t offset = -1; // -1: start at the relay's current end
+
+	while(sleepFor(std::chrono::milliseconds(1000)))
+	{
+		std::vector<std::string> lines;
+		try
+		{
+			auto response = send(http::verb::get, "/to-game?offset=" + std::to_string(offset));
+			offset = std::stoll(std::string(response["X-Next-Offset"]));
+			lines = splitLines(response.body());
+
+			for(;;)
+			{
+				std::string line;
+				{
+					std::lock_guard lock(mutex);
+					if(outbox.empty())
+						break;
+					line = outbox.front();
+				}
+				send(http::verb::post, "/from-game", line);
+				std::lock_guard lock(mutex);
+				outbox.pop_front();
+			}
+
+			if(std::chrono::steady_clock::now() >= nextSaveScan)
+			{
+				nextSaveScan = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+				for(const auto & [path, time] : scanSaves(saveRoot))
+				{
+					auto known = uploaded.find(path);
+					if(known != uploaded.end() && known->second == time)
+						continue;
+					if(std::time(nullptr) - time < 2)
+						continue; // the game may still be writing it
+					const std::string name = utf8(boost::filesystem::relative(path, saveRoot));
+					send(http::verb::put, "/save?name=" + urlEncode(name), readFile(path));
+					uploaded[path] = time;
+					logGlobal->info("Claude bridge: uploaded save %s", name);
+				}
+			}
+			setLink(ELink::CONNECTED, "已连上电脑 " + relay.host);
+		}
+		catch(const std::exception & e)
+		{
+			setLink(ELink::OFFLINE, "连不上电脑 " + relay.host + "，消息先存着");
+			logGlobal->debug("Claude bridge: %s", e.what());
+		}
+		dispatch(std::move(lines));
+	}
+}
+
+void ClaudeBridge::setLink(ELink value, const std::string & description)
+{
+	const ELink old = link.exchange(value);
+	{
+		std::lock_guard lock(mutex);
+		linkDescription = description;
+	}
+	if(old != value || value == ELink::FILES)
+		logGlobal->info("Claude bridge: %s", description);
+}
+
+bool ClaudeBridge::sleepFor(std::chrono::milliseconds duration)
+{
+	const auto until = std::chrono::steady_clock::now() + duration;
+	while(!stopping && std::chrono::steady_clock::now() < until)
+		std::this_thread::sleep_for(std::chrono::milliseconds(50));
+	return !stopping;
+}
+
+void ClaudeBridge::dispatch(std::vector<std::string> lines)
+{
+	if(ENGINE && (!lines.empty() || pendingCount > 0)) // no ENGINE in --headless
+		ENGINE->dispatchMainThread([this, lines]() { deliver(lines); });
+}
+
+void ClaudeBridge::deliver(std::vector<std::string> lines)
+{
+	pending.insert(pending.end(), lines.begin(), lines.end());
+	pendingCount = pending.size();
+	if(!GAME->interface() || !GAME->interface()->cingconsole || !GAME->server().client)
+		return; // not in a game yet: keep them until one is running
+
+	std::vector<std::string> todo;
+	std::swap(todo, pending);
+	pendingCount = 0;
+	bool changed = false;
+	for(const auto & line : todo)
+	{
+		std::string text;
+		std::string kind;
+		std::string from;
+		try
+		{
+			const JsonNode message(line.data(), line.size(), "claude-bridge/to-game.jsonl");
+			text = message["text"].isString() ? message["text"].String() : "";
+			kind = message["kind"].isString() ? message["kind"].String() : "chat";
+			from = message["from"].isString() ? message["from"].String() : claudeName;
+		}
+		catch(const std::exception & e)
+		{
+			logGlobal->error("Claude bridge: bad line %s: %s", line, e.what());
+			continue;
+		}
+
+		if(kind == "open")
+		{
+			if(!ENGINE->windows().topWindow<ClaudeChatWindow>())
+				ENGINE->windows().createAndPushWindow<ClaudeChatWindow>();
+			continue;
+		}
+		if(text.empty())
+			continue;
+		logGlobal->info("Claude bridge: %s from %s: %s", kind, from, text);
+
+		const std::string time = TextOperations::getCurrentFormattedTimeLocal();
+		if(kind == "gm")
+		{
+			// straight to the server, not through GameChatHandler: the key must not reach
+			// from-game.jsonl or an online lobby's chat
+			if(hostKey.empty())
+				logGlobal->error("Claude bridge: no host key, dropping %s", text);
+			else
+				GAME->interface()->cb->sendMessage("#host " + hostKey + " " + text, GAME->interface()->localState->getCurrentArmy());
+		}
+		else if(kind == "command")
+		{
+			// exactly as if the player typed it into the chat (cheat codes included)
+			injecting = true;
+			GAME->server().getGameChat().sendMessageGameplay(text);
+			injecting = false;
+		}
+		else if(kind == "popup")
+		{
+			history.push_back({from, text, time, false});
+			changed = true;
+			GAME->interface()->showInfoDialog(text, std::vector<std::shared_ptr<CComponent>>(), 0);
+		}
+		else
+		{
+			history.push_back({from, text, time, false});
+			unread++;
+			changed = true;
+			GAME->interface()->cingconsole->addMessage(time, from, text);
+		}
+	}
+	if(changed)
+		notify();
+}
+
+void ClaudeBridge::record(const std::string & text, const std::string & kind)
+{
+	std::lock_guard lock(mutex);
+	outbox.push_back(jsonLine(playerName(), text, kind));
+}
+
+void ClaudeBridge::onPlayerChat(const std::string & text)
+{
+	record(text, injecting ? "command" : "chat");
+	if(injecting)
+		return;
+	history.push_back({playerName(), text, TextOperations::getCurrentFormattedTimeLocal(), true});
+	notify();
+}
+
+void ClaudeBridge::onGameEvent(const std::string & text)
+{
+	if(!text.empty())
+		record(text, "event");
+}
+
+void ClaudeBridge::onSystemMessage(const std::string & text)
+{
+	if(boost::starts_with(text, "【Claude】") || boost::starts_with(text, "【回声】"))
+		record(text, "gm-result");
+}
+
+void ClaudeBridge::showLine(const std::string & from, const std::string & text)
+{
+	if(text.empty() || !GAME->interface() || !GAME->interface()->cingconsole)
+		return;
+	const std::string time = TextOperations::getCurrentFormattedTimeLocal();
+	history.push_back({from, text, time, false});
+	unread++;
+	GAME->interface()->cingconsole->addMessage(time, from, text);
+	notify();
+}
+
+void ClaudeBridge::sendFromWindow(const std::string & text)
+{
+	if(text.empty())
+		return;
+	record(text, "chat");
+	history.push_back({playerName(), text, TextOperations::getCurrentFormattedTimeLocal(), true});
+	notify();
+}
+
+const std::vector<ClaudeBridgeMessage> & ClaudeBridge::getHistory() const
+{
+	return history;
+}
+
+int ClaudeBridge::getUnreadCount() const
+{
+	return unread;
+}
+
+void ClaudeBridge::markRead()
+{
+	unread = 0;
+}
+
+void ClaudeBridge::setListener(std::function<void()> callback)
+{
+	listener = std::move(callback);
+}
+
+void ClaudeBridge::notify()
+{
+	if(listener)
+		listener();
+}
+
+ClaudeBridge::ELink ClaudeBridge::getLink() const
+{
+	return link;
+}
+
+std::string ClaudeBridge::getLinkDescription() const
+{
+	std::lock_guard lock(mutex);
+	return linkDescription;
+}
