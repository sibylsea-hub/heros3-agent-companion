+namespace
+{
+// the real colour names; the game's own colour names follow the shown colours
+const char * const colorNames[] = {"红", "蓝", "棕", "绿", "橙", "紫", "青", "粉"};
+
+constexpr int rowTop = 64;
+constexpr int rowHeight = 34;
+}
+
+ClaudeSeatsWindow::ClaudeSeatsWindow()
+	: CWindowObject(BORDERED)
+{
+	OBJECT_CONSTRUCTION;
+	const int count = GAME->server().si ? static_cast<int>(GAME->server().si->playerInfos.size()) : 0;
+	pos.w = 540;
+	pos.h = rowTop + rowHeight * std::max(1, count) + 120;
+
+	background = std::make_shared<CFilledTexture>(ImagePath::builtin("DIBOXBCK"), Rect(0, 0, pos.w, pos.h));
+	title = std::make_shared<CLabel>(pos.w / 2, 22, FONT_BIG, ETextAlignment::CENTER, Colors::YELLOW, "颜色和 Claude");
+	columnLabel = std::make_shared<CLabel>(24, 48, FONT_SMALL, ETextAlignment::CENTERLEFT, Colors::YELLOW, "地图上的颜色");
+	hint = std::make_shared<CMultiLineLabel>(Rect(20, pos.h - 104, pos.w - 40, 64), FONT_SMALL, ETextAlignment::TOPLEFT, Colors::WHITE,
+		"「显示成」只换画面：旗子、界面、名字都换成另一个颜色，规则和存档不变，所有游戏都这样显示。"
+		"「Claude 来打」把一个电脑颜色交给 Claude（没有 Claude 窗口回应时由电脑代打）；热座里的人类座位，把名字填成 Claude 就行。");
+	closeButton = std::make_shared<CButton>(Point(pos.w / 2 - 32, pos.h - 38), AnimationPath::builtin("IOKAY"), CButton::tooltip("关闭"), [this]() { close(); }, EShortcut::GLOBAL_RETURN);
+
+	rebuild();
+	addUsedEvents(TIME);
+	center();
+}
+
+std::string ClaudeSeatsWindow::currentState() const
+{
+	std::string state;
+	if(GAME->server().si)
+		for(const auto & [color, settings] : GAME->server().si->playerInfos)
+			state += std::to_string(color.getNum()) + ":" + settings.name + ":" + (settings.isControlledByHuman() ? "h" : "a") + ";";
+	for(const auto & shown : graphics->getShownColors())
+		state += std::to_string(shown.getNum());
+	return state;
+}
+
+void ClaudeSeatsWindow::rebuild()
+{
+	OBJECT_CONSTRUCTION;
+	rows.clear();
+	shownState = currentState();
+	if(!GAME->server().si || GAME->server().si->playerInfos.empty())
+	{
+		rows.push_back(std::make_shared<CLabel>(24, rowTop + 16, FONT_MEDIUM, ETextAlignment::CENTERLEFT, Colors::WHITE, "先选一张地图"));
+		return;
+	}
+
+	const bool host = !GAME->server().isGuest();
+	int y = rowTop;
+	for(const auto & [color, settings] : GAME->server().si->playerInfos)
+	{
+		if(!color.isValidPlayer() || color.getNum() >= 8)
+			continue;
+		const PlayerColor shown = graphics->shownColor(color);
+		rows.push_back(std::make_shared<CAnimImage>(AnimationPath::builtin("ITGFLAGS"), shown.getNum(), 0, 22, y + 6));
+		rows.push_back(std::make_shared<CLabel>(50, y + 16, FONT_MEDIUM, ETextAlignment::CENTERLEFT, Colors::WHITE, std::string(colorNames[color.getNum()]) + "方"));
+
+		const bool claude = ClaudePlayer::isClaudeName(settings.name);
+		std::string who;
+		if(settings.isControlledByHuman())
+			who = claude ? "Claude（热座）" : settings.name;
+		else
+			who = claude ? "Claude" : "电脑";
+		rows.push_back(std::make_shared<CLabel>(104, y + 16, FONT_SMALL, ETextAlignment::CENTERLEFT, claude ? Colors::YELLOW : Colors::WHITE, who));
+
+		auto shownButton = std::make_shared<CButton>(Point(232, y + 2), AnimationPath::builtin("GSPBUT2.DEF"), CButton::tooltip("显示成", "点一下换成下一个颜色：两个颜色互相对调，别的颜色不变"),
+			[this, color]() { cycleShownColor(color); });
+		shownButton->setTextOverlay("显示成" + std::string(colorNames[shown.getNum()]), FONT_SMALL, Colors::WHITE);
+		rows.push_back(shownButton);
+
+		if(!settings.isControlledByHuman())
+		{
+			auto claudeButton = std::make_shared<CButton>(Point(380, y + 2), AnimationPath::builtin("GSPBUT2.DEF"), CButton::tooltip("Claude 来打", "把这个电脑颜色交给 Claude，或者还给电脑"),
+				[this, color, claude]() { toggleClaude(color, !claude); });
+			claudeButton->setTextOverlay(claude ? "还给电脑" : "Claude 来打", FONT_SMALL, claude ? Colors::YELLOW : Colors::WHITE);
+			if(!host)
+				claudeButton->block(true);
+			rows.push_back(claudeButton);
+		}
+		y += rowHeight;
+	}
+	redraw();
+}
+
+void ClaudeSeatsWindow::cycleShownColor(PlayerColor color)
+{
+	// colours are swapped in pairs: red shown as purple means purple is shown as red, nobody else changes
+	auto shown = graphics->getShownColors();
+	for(int i = 0; i < 8; ++i)
+		if(shown[shown[i].getNum()].getNum() != i)
+		{
+			for(int j = 0; j < 8; ++j)
+				shown[j] = PlayerColor(j); // not pairs (edited by hand): start over
+			break;
+		}
+	auto unpair = [&shown](int c)
+	{
+		const int partner = shown[c].getNum();
+		shown[c] = PlayerColor(c);
+		shown[partner] = PlayerColor(partner);
+	};
+	const int c = color.getNum();
+	const int next = (shown[c].getNum() + 1) % 8;
+	unpair(c);
+	if(next != c)
+	{
+		unpair(next);
+		shown[c] = PlayerColor(next);
+		shown[next] = PlayerColor(c);
+	}
+	graphics->setShownColors(shown);
+	rebuild();
+}
+
+void ClaudeSeatsWindow::toggleClaude(PlayerColor color, bool claude)
+{
+	GAME->server().setPlayerName(color, claude ? "Claude" : "");
+	// the lobby state comes back from the server; tick() notices and rebuilds
+}
+
+void ClaudeSeatsWindow::tick(uint32_t msPassed)
+{
+	sinceCheck += msPassed;
+	if(sinceCheck < 250)
+		return;
+	sinceCheck = 0;
+	if(currentState() != shownState)
+		rebuild();
+}
+
+void ClaudeSeatsWindow::close()
+{
+	CWindowObject::close();
+	// the flags and row backgrounds behind us follow the shown colours
+	if(auto lobby = ENGINE->windows().topWindow<CLobbyScreen>())
+		lobby->updateAfterStateChange();
+	ENGINE->windows().totalRedraw();
+}
