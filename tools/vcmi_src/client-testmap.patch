+					if(army->getCreature(slot) != creature.toCreature())
+						gameHandler->changeStackType(location, creature.toCreature());
+					gameHandler->changeStackCount(location, count, ChangeValueMode::ABSOLUTE);
+				}
+				done = label + " 第 " + std::to_string(number) + " 格 → " + creature.toCreature()->getNamePluralTranslated() + "×" + std::to_string(count);
+			}
+		}
+		else if(verb == "recruits")
+		{
+			const auto * t = currentTown();
+			SetAvailableCreatures pack;
+			pack.tid = t->id;
+			pack.creatures = t->creatures;
+			size_t first = 0;
+			size_t last = pack.creatures.size();
+			std::string amount = argument(command, 1, "数量");
+			if(command.size() > 2)
+			{
+				const int level = std::stoi(command[1]);
+				if(level < 1 || level > static_cast<int>(pack.creatures.size()))
+					throw std::runtime_error("兵种等级要在 1 到 " + std::to_string(pack.creatures.size()) + " 之间");
+				first = level - 1;
+				last = level;
+				amount = command[2];
+			}
+			std::vector<std::string> parts;
+			for(size_t i = first; i < last; ++i)
+			{
+				auto & [available, creatures] = pack.creatures[i];
+				if(creatures.empty())
+					continue; // no dwelling built for this level
+				available = static_cast<ui32>(std::max<int64_t>(0, applyAmount(amount, available)));
+				parts.push_back(creatures.front().toCreature()->getNamePluralTranslated() + " " + std::to_string(available));
+			}
+			if(parts.empty())
+				throw std::runtime_error(t->getNameTranslated() + " 还没有这一级的兵营");
+			gameHandler->sendAndApply(pack);
+			done = t->getNameTranslated() + " 可招募：" + boost::algorithm::join(parts, "、");
+		}
+		else if(verb == "reveal" || verb == "hide")
+		{
+			cheatMapReveal(owner, verb == "reveal");
+			done = owner.toString() + (verb == "reveal" ? " 地图全开" : " 地图重新遮上了");
+		}
+		else if(verb == "puzzle")
+		{
+			// cheatPuzzleReveal without its PlayerCheated
+			const TeamState * team = gs.getPlayerTeam(owner);
+			int count = 0;
+			for(auto & obelisk : gs.getMap().getObjects<CGObelisk>())
+			{
+				if(obelisk->wasVisited(owner))
+					continue;
+				gameHandler->setObjPropertyID(obelisk->id, ObjProperty::OBELISK_VISITED, team->id);
+				for(const auto & color : team->players)
+					gameHandler->setObjPropertyID(obelisk->id, ObjProperty::VISITED, color);
+				count++;
+			}
+			done = owner.toString() + " 的拼图多揭开了 " + std::to_string(count) + " 座方尖碑";
+		}
+		else if(verb == "luck" || verb == "morale" || verb == "fly")
+		{
+			const auto * h = currentHero();
+			if(verb == "luck")
+				cheatMaxLuck(owner, h);
+			else if(verb == "morale")
+				cheatMaxMorale(owner, h);
+			else
+				cheatFly(owner, h);
+			done = h->getNameTranslated() + (verb == "luck" ? " 的运气从此最高" : verb == "morale" ? " 的士气从此最高" : " 从此能飞");
+		}
+		else if(verb == "teleport")
+		{
+			// cheatTeleport, but it says why when it can't, and takes the standing tile
+			const auto * h = currentHero();
+			const int3 tile(std::stoi(argument(command, 1, "x")), std::stoi(argument(command, 2, "y")),
+				command.size() > 3 ? std::stoi(command[3]) : h->visitablePos().z);
+			if(!gs.getMap().isInTheMap(tile))
+				throw std::runtime_error("坐标不在地图里");
+			const auto & destination = gs.getMap().getTile(tile);
+			const auto & here = gs.getMap().getTile(h->visitablePos());
+			if(!destination.isClear(&here))
+				throw std::runtime_error("那一格站不了人（有东西挡着，或者是水/岩石）");
+			if(!gameHandler->moveHero(h->id, h->convertFromVisitablePos(tile), EMovementMode::DIMENSION_DOOR))
+				throw std::runtime_error("传送没成功");
+			done = h->getNameTranslated() + " 传送到 (" + std::to_string(tile.x) + ", " + std::to_string(tile.y) + ", " + std::to_string(tile.z) + ")";
+		}
+		else
+			throw std::runtime_error("不认识的命令：" + verb);
+
+		logGlobal->info("Host command from %s: %s -> %s", player.toString(), boost::algorithm::join(command, " "), done);
+		broadcastSystemMessage("【Claude】" + done);
+	}
+	catch(const std::exception & e)
+	{
+		logGlobal->warn("Host command from %s failed: %s", player.toString(), e.what());
+		broadcastSystemMessage("【Claude】没办成：" + std::string(e.what()));
+	}
+	return true;
+}
