+}
+
+void ClaudePlayer::onPack(const CPack & pack)
+{
+	std::lock_guard lock(mx);
+	if(seats.empty())
+		return;
+
+	auto tell = [this](PlayerColor color, const std::string & text)
+	{
+		auto it = seats.find(color);
+		if(it == seats.end() || text.empty())
+			return;
+		auto & seat = *it->second;
+		(seat.commandRunning ? seat.commandEvents : seat.events).push_back(text);
+	};
+
+	if(const auto * query = dynamic_cast<const Query *>(&pack))
+	{
+		if(query->queryID.getNum() >= 0 && !dynamic_cast<const PlayerStartsTurn *>(&pack))
+			pendingQueries.insert(query->queryID);
+	}
+
+	if(const auto * p = dynamic_cast<const PlayerEndsTurn *>(&pack))
+	{
+		auto it = seats.find(p->player);
+		if(it != seats.end())
+			it->second->turnEnded = true;
+	}
+	else if(const auto * p = dynamic_cast<const InfoWindow *>(&pack))
+		tell(p->player, "消息：" + oneLine(p->text.toString()));
+	else if(const auto * p = dynamic_cast<const BlockingDialog *>(&pack))
+		tell(p->player, "询问（电脑替你回答了）：" + oneLine(p->text.toString()));
+	else if(const auto * p = dynamic_cast<const HeroLevelUp *>(&pack))
+	{
+		const auto * hero = client ? client->gameInfo().getHero(p->heroId) : nullptr;
+		tell(p->player, (hero ? hero->getNameTranslated() : std::string("英雄")) + " 升级了（技能由电脑替你选）");
+	}
+	else if(const auto * p = dynamic_cast<const SystemMessage *>(&pack))
+	{
+		for(auto & [color, seat] : seats)
+			if(seat->commandRunning)
+				seat->commandEvents.push_back("服务器：" + oneLine(p->text.toString()));
+	}
+	else if(const auto * p = dynamic_cast<const BattleResult *>(&pack))
+	{
+		const BattleInfo * battle = client ? client->gameState().getBattle(p->battleID) : nullptr;
+		if(!battle)
+			return;
+		for(auto side : {BattleSide::ATTACKER, BattleSide::DEFENDER})
+		{
+			const PlayerColor color = battle->getSide(side).color;
+			if(!seats.count(color))
+				continue;
+			const auto enemySide = side == BattleSide::ATTACKER ? BattleSide::DEFENDER : BattleSide::ATTACKER;
+			const auto * hero = battle->getSide(side).getHero();
+			const auto * enemyHero = battle->getSide(enemySide).getHero();
+			const auto * enemyArmy = battle->getSide(enemySide).getArmy();
+			std::string text = std::string("战斗：") + (hero ? hero->getNameTranslated() : std::string("你的部队")) + " 对 "
+				+ (enemyHero ? enemyHero->getNameTranslated() : (enemyArmy ? enemyArmy->getObjectName() : std::string("敌人")))
+				+ (p->winner == side ? "，赢了" : p->winner == enemySide ? "，输了" : "，平局");
+			if(p->result == EBattleResult::ESCAPE)
+				text += "（有一方逃跑）";
+			else if(p->result == EBattleResult::SURRENDER)
+				text += "（有一方投降）";
+			auto losses = [](const std::map<CreatureID, si32> & casualties)
+			{
+				std::string out;
+				for(const auto & [id, count] : casualties)
+					out += (out.empty() ? "" : "，") + id.toCreature()->getNamePluralTranslated() + "×" + std::to_string(count);
+				return out.empty() ? std::string("无") : out;
+			};
+			text += "；我方损失：" + losses(p->casualties[side]) + "；对方损失：" + losses(p->casualties[enemySide]);
+			tell(color, text);
+		}
+	}
+}
