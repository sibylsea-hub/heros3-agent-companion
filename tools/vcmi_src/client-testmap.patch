+const CGHeroInstance * findHero(const Seat & seat, const std::string & key)
+{
+	const auto heroes = seat.cb->getHeroesInfo();
+	std::string k = key;
+	if(k.size() > 1 && (k[0] == 'H' || k[0] == 'h') && isNumber(k.substr(1)))
+		k = k.substr(1);
+	if(isNumber(k))
+	{
+		const size_t index = std::stoul(k);
+		if(index >= 1 && index <= heroes.size())
+			return heroes[index - 1];
+	}
+	for(const auto * h : heroes)
+		if(h->getNameTranslated() == key)
+			return h;
+	std::string names;
+	for(size_t i = 0; i < heroes.size(); ++i)
+		names += (names.empty() ? "" : "，") + std::string("H") + std::to_string(i + 1) + " " + heroes[i]->getNameTranslated();
+	throw Refused("没有这个英雄：" + key + "（你的英雄：" + (names.empty() ? std::string("没有") : names) + "）");
+}
+
+const CGTownInstance * findTown(const Seat & seat, const std::string & key)
+{
+	const auto towns = seat.cb->getTownsInfo();
+	std::string k = key;
+	if(k.size() > 1 && (k[0] == 'T' || k[0] == 't') && isNumber(k.substr(1)))
+		k = k.substr(1);
+	if(isNumber(k))
+	{
+		const size_t index = std::stoul(k);
+		if(index >= 1 && index <= towns.size())
+			return towns[index - 1];
+	}
+	for(const auto * t : towns)
+		if(t->getNameTranslated() == key)
+			return t;
+	std::string names;
+	for(size_t i = 0; i < towns.size(); ++i)
+		names += (names.empty() ? "" : "，") + std::string("T") + std::to_string(i + 1) + " " + towns[i]->getNameTranslated();
+	throw Refused("没有这座城：" + key + "（你的城：" + (names.empty() ? std::string("没有") : names) + "）");
+}
+
+BuildingID findBuilding(const CGTownInstance * town, const std::string & key)
+{
+	const auto & buildings = town->getTown()->buildings;
+	if(isNumber(key) && buildings.count(BuildingID(std::stoi(key))))
+		return BuildingID(std::stoi(key));
+	std::vector<BuildingID> partial;
+	for(const auto & [id, building] : buildings)
+	{
+		if(boost::algorithm::iequals(shortKey(building->getJsonKey()), key) || boost::algorithm::iequals(building->getJsonKey(), key) || building->getNameTranslated() == key)
+			return id;
+		if(building->getNameTranslated().find(key) != std::string::npos)
+			partial.push_back(id);
+	}
+	if(partial.size() == 1)
+		return partial.front();
+	throw Refused(town->getNameTranslated() + " 没有叫 " + key + " 的建筑" + (partial.size() > 1 ? "（名字对上好几个，写全一点）" : "（brief 里方括号里是建筑代号）"));
+}
