+std::string actionsText(const CGameState & gs, Seat & seat)
+{
+	const auto & cb = *seat.cb;
+	const auto res = cb.getResourceAmount();
+	std::vector<std::pair<std::string, std::string>> items; // command, description
+
+	items.emplace_back("end", "结束回合");
+	const auto heroes = cb.getHeroesInfo();
+	for(size_t i = 0; i < heroes.size(); ++i)
+	{
+		const auto * h = heroes[i];
+		if(h->isGarrisoned() || h->movementPointsRemaining() == 0)
+			continue;
+		int n = 0;
+		for(const auto & d : destinations(seat, h, 0))
+		{
+			if(n++ >= 8)
+				break;
+			const int3 p = d.object->visitablePos();
+			items.emplace_back("move H" + std::to_string(i + 1) + " " + std::to_string(p.x) + " " + std::to_string(p.y) + " " + std::to_string(p.z),
+				h->getNameTranslated() + " 去 " + oneLine(d.object->getHoverText(h)) + "，到了剩 " + std::to_string(d.moveRemains) + " 行动力");
+		}
+	}
+	const auto towns = cb.getTownsInfo();
+	for(size_t i = 0; i < towns.size(); ++i)
+	{
+		const auto * t = towns[i];
+		const std::string T = "T" + std::to_string(i + 1);
+		for(const auto & b : buildableNow(cb, t, false))
+			items.emplace_back("build " + T + " " + buildingKey(t, b), t->getNameTranslated() + " 建 " + buildingName(t, b) + "：" + costText(t->getTown()->buildings.at(b)->resources));
+		for(const auto & option : recruitOptions(t))
+		{
+			if(option.available <= 0)
+				continue;
+			const auto * c = option.creature.toCreature();
+			const int canPay = affordable(c->getFullRecruitCost(), res);
+			if(canPay <= 0)
+				continue;
+			items.emplace_back("recruit " + T + " " + shortKey(c->getJsonKey()) + " max",
+				t->getNameTranslated() + " 招 " + c->getNamePluralTranslated() + "：有 " + std::to_string(option.available) + " 只，每只 " + costText(c->getFullRecruitCost())
+				+ "，现在最多买 " + std::to_string(std::min(canPay, option.available)) + " 只");
+		}
+		if(t->hasBuilt(BuildingID::TAVERN) && !t->getVisitingHero() && res[GameResID::GOLD] >= GameConstants::HERO_GOLD_COST)
+		{
+			int n = 0;
+			for(const auto * h : cb.getAvailableHeroes(t))
+			{
+				++n;
+				items.emplace_back("hire " + T + " " + std::to_string(n), t->getNameTranslated() + " 的酒馆招 " + h->getNameTranslated() + "（" + h->getHeroClass()->getNameTranslated() + "）：" + std::to_string(GameConstants::HERO_GOLD_COST) + " 金");
+			}
+		}
+	}
+
+	seat.actionList.clear();
+	std::ostringstream out;
+	out << "现在能做的事（直接发编号也行，比如 \"3\"；局面一变编号就要重新列）：\n";
+	for(size_t i = 0; i < items.size(); ++i)
+	{
+		seat.actionList.push_back(items[i].first);
+		out << "[" << (i + 1) << "] " << items[i].first << " — " << items[i].second << "\n";
+	}
+	return out.str();
+}
