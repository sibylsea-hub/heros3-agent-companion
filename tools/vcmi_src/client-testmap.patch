+// ---- H3 Mod local patch: 主持人命令 (host commands) ----
+//
+// Claude ("回声") changes the running game through the client's ClaudeBridge: Claude writes a
+// line of kind "gm" to claude-bridge/to-game.jsonl, and the client sends it on as the chat
+// message "#host <key> <command>". The key is in <user data>/claude-bridge/host-key.txt, so only
+// a client on the machine that runs this server can use it. The edits are the ones
+// tools/vcmi_src/save_edit.cpp makes to saves, through the same CGameHandler calls as the cheat
+// codes, but without PlayerCheated: nobody is marked as a cheater. Each result goes back as a
+// system message starting with 【Claude】, which the client also forwards to Claude.
+//
+//   [hero=<name|id>] [town=<name|id>] [player=<colour>] then one of
+//   give <creature> <count> | resource <name> <n|+n|-n> | artifact <artifact> [slot]
+//   exp <n> | levels <n> | primary <attack|defence|spellpower|knowledge> <n|+n|-n>
+//   skill <skill> <0-3> | spell <spell> | mana <n|+n|-n> | move [points]
+//   build <building> | raze <building>
+//   army <slot 1-7> <creature> <count> | army <slot 1-7> none   (town= without hero=: the garrison)
+//   recruits [level 1-7] <n|+n|-n>    creatures waiting in the town's dwellings
+//   reveal | hide | puzzle            map, obelisk puzzle (like the cheats, minus the cheater mark)
+//   luck | morale | fly               permanent max luck / max morale / flying for the hero
+//   teleport <x> <y> [z]              standing tile, as tools/vcmi_save.py prints it
+// Names: VCMI identifiers (goldDragon, capitol) or the in-game names (金龙, 国会).
+// The extra commands are the ones the original game's trainers and cheat codes offer most.
+namespace
+{
+const std::string HOST_PREFIX = "#host ";
+
+std::string readHostKey()
+{
+	boost::filesystem::path dir = VCMIDirs::get().userDataPath() / "claude-bridge"; // as ClaudeBridge::directory()
+	if(const char * custom = std::getenv("VCMI_CLAUDE_BRIDGE"))
+		dir = custom;
+	std::ifstream in((dir / "host-key.txt").c_str());
+	std::string key;
+	in >> key;
+	return key;
+}
+
+/// "+5" / "-5" add, "5" sets
+int64_t applyAmount(const std::string & text, int64_t current)
+{
+	const int64_t value = std::stoll(text);
+	return !text.empty() && (text[0] == '+' || text[0] == '-') ? current + value : value;
+}
+
+/// VCMI identifier (case-insensitive, any mod scope) or the translated in-game name
+template<typename Objects, typename NameFn>
+int32_t resolveEntity(const std::string & type, const std::string & text, const Objects & objects, NameFn names)
+{
+	if(auto id = LIBRARY->identifiers()->getIdentifierCaseInsensitive(ModScope::scopeGame(), type, text, true))
+		return *id;
+	for(const auto & object : objects)
+		if(object)
+			for(const auto & name : names(*object))
+				if(name == text)
+					return object->getIndex();
+	throw std::runtime_error("不认识的 " + type + "：" + text);
+}
+
+const std::string & argument(const std::vector<std::string> & words, size_t i, const std::string & what)
+{
+	if(i >= words.size())
+		throw std::runtime_error("少了参数：" + what);
+	return words[i];
+}
+}
