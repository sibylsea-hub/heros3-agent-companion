+std::string briefing(const CGameState & gs, const Seat & seat, const std::vector<std::string> & changes, bool turnStart)
+{
+	const auto & cb = *seat.cb;
+	std::ostringstream out;
+	out << "# " << colorName(seat.color) << "（" << seat.name << "）· " << dateText(cb) << "\n";
+	if(turnStart)
+		out << "轮到你了。" << seat.timeout << " 秒内不发命令（每条命令重新计时），这回合剩下的就交给电脑打完。\n";
+	out << "地图：" << gs.getMap().name.toString() << "\n";
+	std::string swaps;
+	for(int i = 0; i < 8; ++i)
+		if(graphics && graphics->shownColor(PlayerColor(i)) != PlayerColor(i))
+			swaps += (swaps.empty() ? "" : "、") + std::string(colorNames[i]) + "显示成" + colorNames[graphics->shownColor(PlayerColor(i)).getNum()];
+	if(!swaps.empty())
+		out << "注意：玩家的屏幕上颜色换过（只是显示）：" << swaps << "。游戏自己的文字（比如「……玩家占有」）用的是显示出来的颜色名；"
+			<< "这份简报里写「红」「蓝」的地方是地图上真正的颜色。跟玩家说话时，按玩家看到的颜色说。\n";
+
+	if(turnStart)
+	{
+		out << "\n## 上回合以来\n";
+		if(changes.empty())
+			out << "- " << (seat.lastTurnEnd ? "没什么变化" : "这是你接手后的第一回合") << "\n";
+		for(const auto & line : changes)
+			out << "- " << line << "\n";
+	}
+
+	const auto res = cb.getResourceAmount();
+	out << "\n## 资源\n";
+	bool first = true;
+	for(int r : resourceOrder)
+	{
+		out << (first ? "" : " · ") << resourceName(r) << " " << res[r];
+		first = false;
+	}
+	out << "\n";
+
+	const auto heroes = cb.getHeroesInfo();
+	out << "\n## 英雄\n";
+	if(heroes.empty())
+		out << "（没有英雄）\n";
+	for(size_t i = 0; i < heroes.size(); ++i)
+		out << heroLine(heroes[i], static_cast<int>(i + 1)) << "\n";
+
+	const auto towns = cb.getTownsInfo();
+	out << "\n## 城镇\n";
+	if(towns.empty())
+		out << "（没有城镇）\n";
+	for(size_t i = 0; i < towns.size(); ++i)
+	{
+		const auto * t = towns[i];
+		out << "T" << (i + 1) << " " << t->getNameTranslated() << "（" << t->getFactionID().toEntity(LIBRARY)->getNameTranslated() << "）在 " << pos(t->visitablePos()) << "\n";
+		out << "   驻军：" << armyText(*t);
+		if(t->getGarrisonHero())
+			out << "（驻守英雄 " << t->getGarrisonHero()->getNameTranslated() << "）";
+		if(t->getVisitingHero())
+			out << "；来访英雄：" << t->getVisitingHero()->getNameTranslated();
+		out << "\n";
+		std::string built;
+		for(const auto & b : t->getBuildings())
+			if(!buildingName(t, b).empty())
+				built += (built.empty() ? "" : "、") + buildingName(t, b);
+		out << "   已建：" << built << "\n";
+		const auto canBuild = buildableNow(cb, t, true);
+		if(t->built >= cb.getSettings().getInteger(EGameSettings::TOWNS_BUILDINGS_PER_TURN_CAP))
+			out << "   今天已经建过了\n";
+		else if(!canBuild.empty())
+		{
+			std::string list;
+			for(const auto & b : canBuild)
+			{
+				const auto & cost = t->getTown()->buildings.at(b)->resources;
+				list += (list.empty() ? "" : "；") + buildingName(t, b) + "[" + buildingKey(t, b) + "] " + costText(cost)
+					+ (cb.canBuildStructure(t, b) == EBuildingState::NO_RESOURCES ? "（缺 " + missingText(cost, res) + "）" : "");
+			}
+			out << "   今天能建：" << list << "\n";
+		}
+		std::string recruits;
+		for(const auto & option : recruitOptions(t))
+		{
+			if(option.available <= 0)
+				continue;
+			const auto * c = option.creature.toCreature();
+			recruits += (recruits.empty() ? "" : "；") + c->getNamePluralTranslated() + "[" + shortKey(c->getJsonKey()) + "] " + std::to_string(option.available) + " 只，每只 " + costText(c->getFullRecruitCost());
+		}
+		if(!recruits.empty())
+			out << "   能招：" << recruits << "\n";
+		if(t->hasBuilt(BuildingID::TAVERN))
+		{
+			std::string tavern;
+			int n = 0;
+			for(const auto * h : cb.getAvailableHeroes(t))
+				tavern += (tavern.empty() ? "" : "；") + std::to_string(++n) + ". " + h->getNameTranslated() + "（" + h->getHeroClass()->getNameTranslated() + "）";
+			if(!tavern.empty())
+				out << "   酒馆（" << GameConstants::HERO_GOLD_COST << " 金）：" << tavern << "\n";
+		}
+	}
+
+	const auto snapshot = takeSnapshot(gs, seat);
+	out << "\n## 看得见的别家\n";
+	if(snapshot.others.empty())
+		out << "（没看到）\n";
+	int shown = 0;
+	for(const auto & [id, text] : snapshot.others)
+	{
+		if(++shown > 12)
+		{
+			out << "- ……还有 " << snapshot.others.size() - 12 << " 个\n";
+			break;
+		}
+		out << "- " << text << "\n";
+	}
+
+	out << "\n## 附近能去的（目的地坐标；本回合 = 今天走得到）\n";
+	for(size_t i = 0; i < heroes.size(); ++i)
+	{
+		const auto * h = heroes[i];
+		if(h->isGarrisoned())
+			continue;
+		const auto list = destinations(seat, h, 1);
+		out << "H" << (i + 1) << " " << h->getNameTranslated() << "：\n";
+		int today = 0;
+		int tomorrow = 0;
+		for(const auto & d : list)
+		{
+			if(d.turns == 0 && today++ < 10)
+				out << "   本回合 " << destinationText(d, h) << "（到了剩 " << d.moveRemains << " 行动力）\n";
+			else if(d.turns == 1 && tomorrow++ < 6)
+				out << "   明天 " << destinationText(d, h) << "\n";
+		}
+		if(list.empty())
+			out << "   （两天内走不到什么）\n";
+	}
+
+	out << "\n" << commandHelp() << "\n";
+	return out.str();
+}
