+
+class CClient;
+
+/// Claude as a local hotseat player.
+///
+/// A hotseat seat whose player name is "Claude" (or "回声") gets no CPlayerInterface. The client
+/// installs the usual adventure AI for it, which answers dialogs, fights battles (auto battle) and
+/// stands in when Claude is silent, but the AI does not get the turn: Claude does. Turns travel as
+/// files in <claude-bridge>/player/ (see ClaudePlayer.cpp):
+/// - briefing.md, outbox.jsonl: the turn briefing (what this colour can see, what changed since its
+///   last turn), replies to commands, the end-of-turn summary;
+/// - inbox.jsonl: commands from Claude (move, build, recruit, hire, end, say, ...), checked one by
+///   one and refused with a reason when they are not possible;
+/// - state.json: whose turn it is and how long Claude has left.
+/// If Claude sends nothing for a few minutes, the AI plays the rest of the turn.
+/// tools/vcmi_claude_player.py is the command line end of this.
+class ClaudePlayer : boost::noncopyable
+{
+public:
+	static ClaudePlayer & get();
+
+	/// Claude plays a hotseat seat named "Claude" (any case, also "Claude 2" etc.) or "回声"
+	static bool isClaudeName(const std::string & name);
+	/// a human seat that a person plays (not Claude); UI code uses this instead of isControlledByHuman()
+	static bool isPerson(const PlayerSettings & settings);
+
+	/// CClient::initPlayerInterfaces (network thread). `standIn` is the AI already installed for the colour
+	void attach(CClient & client, PlayerColor color, std::shared_ptr<CGameInterface> standIn);
+	/// CClient::finishGameplay: stop everything before the game state goes away
+	void detach();
+
+	bool controls(PlayerColor color) const;
+	/// network thread, PlayerStartsTurn. Returns false if the stand-in AI should get the turn as usual
+	bool onYourTurn(PlayerColor color, QueryID queryID);
+	/// network thread, after a pack was applied
+	void onPack(const CPack & pack);
+	/// any thread, CClient::sendRequest
+	void onRequest(const CPackForServer & request, PlayerColor player);
+
+	struct Seat;
+	struct Snapshot;
+	ClaudePlayer();
+	~ClaudePlayer();
+
+private:
+	mutable std::mutex mx;
+	CClient * client = nullptr;
+	std::map<PlayerColor, std::shared_ptr<Seat>> seats;
+	std::set<QueryID> pendingQueries; // asked by the server, not answered yet (any colour of this client)
+	std::thread worker;
+	std::atomic<bool> stopping = false;
+	uintmax_t inboxOffset = 0;
+	std::string turnSummary; // worker thread: text of the last finished turn
+
+	void run();
+	void startTurn(Seat & seat);
+	void finishTurn(Seat & seat);
+	void handOver(Seat & seat, const std::string & reason);
+	void pollInbox();
+	void handleRequest(const std::string & line);
+	std::string execute(Seat & seat, const std::string & command, bool & ok, bool & turnOver);
+	bool waitQuiet(Seat & seat, std::shared_lock<std::shared_mutex> & gsLock);
+	void writeState();
+	std::shared_ptr<Seat> seatFor(const std::string & colorName);
+};
