+
+void Graphics::applyShownColors()
+{
+	std::array<int, 8> names;
+	for(int i = 0; i < 8; ++i)
+	{
+		playerColors[i] = basePlayerColors[shownColors[i].getNum()];
+		playerColorPalette[i] = basePlayerColorPalette[shownColors[i].getNum()];
+		names[i] = shownColors[i].getNum();
+	}
+	TextLocalizationContainer::setShownPlayerColors(names);
+}
+
+PlayerColor Graphics::shownColor(PlayerColor player) const
+{
+	return player.isValidPlayer() && player.getNum() < 8 ? shownColors[player.getNum()] : player;
+}
+
+const std::array<PlayerColor, 8> & Graphics::getShownColors() const
+{
+	return shownColors;
+}
+
+void Graphics::setShownColors(const std::array<PlayerColor, 8> & shown)
+{
+	shownColors = shown;
+	applyShownColors();
+	std::string text = "{\n\t\"shown\": [";
+	for(int i = 0; i < 8; ++i)
+		text += std::string(i ? ", " : "") + "\"" + GameConstants::PLAYER_COLOR_NAMES[shownColors[i].getNum()] + "\"";
+	text += "],\n\t\"note\": \"H3 Mod: entry i is the colour player colour i is shown as (red, blue, tan, green, orange, purple, teal, pink). Display only.\"\n}\n";
+	const auto path = VCMIDirs::get().userConfigPath() / "h3mod-colors.json";
+	std::ofstream out(path.c_str(), std::ios::binary | std::ios::trunc);
+	out << text;
 }
 
