+void appendLine(const boost::filesystem::path & file, const std::string & line)
+{
+	boost::system::error_code ec;
+	boost::filesystem::create_directories(file.parent_path(), ec);
+	std::ofstream out(file.c_str(), std::ios::binary | std::ios::app);
+	out << line << '\n';
+}
+
+void writeAtomic(const boost::filesystem::path & file, const std::string & text)
+{
+	boost::system::error_code ec;
+	boost::filesystem::create_directories(file.parent_path(), ec);
+	auto temp = file;
+	temp += ".tmp";
+	{
+		std::ofstream out(temp.c_str(), std::ios::binary | std::ios::trunc);
+		out << text;
+	}
+	boost::filesystem::rename(temp, file, ec);
+	if(ec)
+		logGlobal->error("Claude player: cannot write %s: %s", file.string(), ec.message());
+}
+
+struct Config
+{
+	int timeout = 180;       // seconds without a command before the AI takes over
+	int idleTimeout = 20;    // the same when no Claude window has been around lately
+	int listenerFresh = 900; // listener.json younger than this: someone is listening
+};
+
+Config readConfig()
+{
+	Config config;
+	const auto path = playerDir() / "config.json";
+	boost::system::error_code ec;
+	if(boost::filesystem::exists(path, ec))
+	{
+		try
+		{
+			std::ifstream in(path.c_str(), std::ios::binary);
+			const std::string data((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+			const JsonNode node(data.data(), data.size(), "claude-bridge/player/config.json");
+			if(node["timeout"].isNumber())
+				config.timeout = static_cast<int>(node["timeout"].Integer());
+			if(node["idleTimeout"].isNumber())
+				config.idleTimeout = static_cast<int>(node["idleTimeout"].Integer());
+			if(node["listenerFresh"].isNumber())
+				config.listenerFresh = static_cast<int>(node["listenerFresh"].Integer());
+		}
+		catch(const std::exception & e)
+		{
+			logGlobal->error("Claude player: bad config.json: %s", e.what());
+		}
+	}
+	if(const char * value = std::getenv("VCMI_CLAUDE_PLAYER_TIMEOUT"))
+		config.timeout = std::max(5, std::atoi(value));
+	return config;
+}
+
+bool listenerAlive(const Config & config)
+{
+	boost::system::error_code ec;
+	const std::time_t touched = boost::filesystem::last_write_time(playerDir() / "listener.json", ec);
+	return !ec && std::time(nullptr) - touched < config.listenerFresh;
+}
