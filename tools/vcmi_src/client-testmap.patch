+/*
+ * ClaudeBridge.h, H3 Mod local patch (not part of VCMI)
+ *
+ * License: GNU General Public License v2.0 or later
+ *
+ */
+#pragma once
+
+/// One line of the conversation between the local player and Claude
+struct ClaudeBridgeMessage
+{
+	std::string sender;
+	std::string text;
+	std::string time;
+	bool fromPlayer;
+};
+
+/// Chat between the local player and a Claude session outside the game.
+///
+/// Messages are JSON lines {"ts", "from", "text", "kind"} in <userDataPath>/claude-bridge/
+/// (VCMI_CLAUDE_BRIDGE overrides the folder):
+/// - to-game.jsonl: lines from Claude. kind "chat" (default) goes to the Claude window and the
+///   in-game console, "popup" opens an info dialog, "open" opens the Claude window, "command" is
+///   sent to the game chat as if the player typed it (cheat codes included), "gm" is a 主持人命令:
+///   sent to the server as "#host <key> <text>" (key: claude-bridge/host-key.txt, made on first
+///   run), which changes the game without marking anyone as a cheater
+///   (PlayerMessageProcessor::handleHostCommand). Its answer, a system message starting with
+///   【Claude】, comes back to Claude with kind "gm-result".
+/// - from-game.jsonl: what the player says, in the Claude window or the in-game chat; and, with
+///   kind "event", what happens to the player (visits, messages, questions, battles), so Claude
+///   knows the story so far. tools/vcmi_watch.py folds the events into its turn digests.
+///
+/// If claude-bridge/config.json names a relay ({"relay": "http://host:port", "token": "..."}),
+/// the same lines travel over HTTP to tools/vcmi_relay.py on the PC instead, and every new save
+/// under the save folder is uploaded there, so a phone or tablet can play along.
+class ClaudeBridge : boost::noncopyable
+{
+public:
+	enum class ELink
+	{
+		FILES,      // no relay configured: local files
+		CONNECTING, // relay configured, no answer yet
+		CONNECTED,
+		OFFLINE     // relay configured but unreachable or refusing; outgoing lines wait
+	};
+
+	ClaudeBridge();
+	~ClaudeBridge();
+
+	/// Main thread. The player sent text to the game chat (Tab console)
+	void onPlayerChat(const std::string & text);
+	/// Main thread. The player wrote to Claude in the Claude window: local only, never sent to the game server
+	void sendFromWindow(const std::string & text);
+	/// Something happened to the local player (see CPlayerInterface). Goes to Claude only, not to the Claude window
+	void onGameEvent(const std::string & text);
+	/// Main thread. Claude, playing a hotseat seat (ClaudePlayer), says something: Claude window and in-game console
+	void showLine(const std::string & from, const std::string & text);
+	/// A system message arrived; answers to host commands (【Claude】...) go back to Claude
+	void onSystemMessage(const std::string & text);
+
+	const std::vector<ClaudeBridgeMessage> & getHistory() const;
+	int getUnreadCount() const;
+	void markRead();
+	/// Called on the main thread whenever history or the unread count change
+	void setListener(std::function<void()> callback);
+
+	ELink getLink() const;
+	std::string getLinkDescription() const;
+
+	static boost::filesystem::path directory();
+
+private:
+	struct Relay
+	{
+		std::string host;
+		std::string port;
+		std::string token;
+	};
+
+	std::thread thread;
+	std::atomic<bool> stopping = false;
+	std::atomic<ELink> link = ELink::FILES;
+	std::string hostKey; // for "gm" lines, see above
+
+	mutable std::mutex mutex; // guards outbox and linkDescription
+	std::deque<std::string> outbox;
+	std::string linkDescription;
+
+	// main thread only
+	std::vector<ClaudeBridgeMessage> history;
+	std::vector<std::string> pending; // lines waiting until a game is running
+	std::atomic<size_t> pendingCount = 0;
+	int unread = 0;
+	bool injecting = false;
+	std::function<void()> listener;
+
+	void run();
+	void runFiles();
+	void runRelay(const Relay & relay);
+	void setLink(ELink value, const std::string & description);
+	bool sleepFor(std::chrono::milliseconds duration);
+	void dispatch(std::vector<std::string> lines);
+	void deliver(std::vector<std::string> lines);
+	void record(const std::string & text, const std::string & kind);
+	void notify();
+};
