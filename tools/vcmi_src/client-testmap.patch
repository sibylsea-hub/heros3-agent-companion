+	/// don't change. The choice lives in <user config>/h3mod-colors.json, is set in the lobby
+	/// (client/lobby/ClaudeSeatsWindow) and is always a permutation, so two players never look alike.
+	PlayerColor shownColor(PlayerColor player) const;
+	/// shown[i] for each player colour i
+	const std::array<PlayerColor, 8> & getShownColors() const;
+	/// apply and save
+	void setShownColors(const std::array<PlayerColor, 8> & shown);
+
+private:
+	std::array<ColorRGBA, 8> basePlayerColors;
+	std::array<PlayerPalette, 8> basePlayerColorPalette;
+	std::array<PlayerColor, 8> shownColors;
+	void applyShownColors();
 };
 
