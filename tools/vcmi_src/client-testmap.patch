+Snapshot takeSnapshot(const CGameState & gs, const Seat & seat)
+{
+	Snapshot s;
+	s.day = seat.cb->getDate(Date::DAY);
+	s.resources = seat.cb->getResourceAmount();
+	for(const auto * h : seat.cb->getHeroesInfo())
+		s.heroes[h->id] = {h->getNameTranslated(), h->visitablePos(), static_cast<int>(h->level), armyText(*h)};
+	for(const auto * t : seat.cb->getTownsInfo())
+		s.towns[t->id] = {t->getNameTranslated(), t->getBuildings(), armyText(*t)};
+	for(const auto * obj : seat.cb->getMyObjects())
+		if(obj->ID != Obj::HERO && obj->ID != Obj::TOWN)
+			s.owned[obj->id] = obj->getObjectName() + " " + pos(obj->visitablePos());
+	for(const auto * obj : seat.cb->getAllVisitableObjs())
+	{
+		if(!obj->getOwner().isValidPlayer() || obj->getOwner() == seat.color)
+			continue;
+		if(obj->ID == Obj::HERO)
+		{
+			const auto * h = dynamic_cast<const CGHeroInstance *>(obj);
+			s.others[obj->id] = playerLabel(gs, obj->getOwner()) + " 的英雄 " + (h ? h->getNameTranslated() : obj->getObjectName()) + " 在 " + pos(obj->visitablePos());
+		}
+		else if(obj->ID == Obj::TOWN)
+		{
+			const auto * t = dynamic_cast<const CGTownInstance *>(obj);
+			s.others[obj->id] = playerLabel(gs, obj->getOwner()) + " 的城 " + (t ? t->getNameTranslated() : obj->getObjectName()) + " 在 " + pos(obj->visitablePos());
+		}
+	}
+	return s;
+}
+
+std::vector<std::string> diffSnapshots(const CGameState & gs, const Seat & seat, const Snapshot & a, const Snapshot & b)
+{
+	std::vector<std::string> out;
+	std::string res;
+	for(int r : resourceOrder)
+	{
+		const auto delta = b.resources[r] - a.resources[r];
+		if(delta == 0)
+			continue;
+		if(!res.empty())
+			res += "，";
+		res += resourceName(r) + " " + std::to_string(a.resources[r]) + "→" + std::to_string(b.resources[r]) + (delta > 0 ? "（+" : "（") + std::to_string(delta) + "）";
+	}
+	if(!res.empty())
+		out.push_back("资源：" + res);
+
+	for(const auto & [id, h] : b.heroes)
+	{
+		auto it = a.heroes.find(id);
+		if(it == a.heroes.end())
+		{
+			out.push_back("新英雄：" + h.name + "（" + std::to_string(h.level) + " 级）在 " + pos(h.position) + "，兵：" + h.army);
+			continue;
+		}
+		const auto & old = it->second;
+		if(h.level != old.level)
+			out.push_back(h.name + " 从 " + std::to_string(old.level) + " 级升到 " + std::to_string(h.level) + " 级");
+		if(h.position != old.position)
+			out.push_back(h.name + " 从 " + pos(old.position) + " 到了 " + pos(h.position));
+		if(h.army != old.army)
+			out.push_back(h.name + " 的兵：" + old.army + " → " + h.army);
+	}
+	for(const auto & [id, h] : a.heroes)
+		if(!b.heroes.count(id))
+			out.push_back("失去了英雄 " + h.name + "（上次在 " + pos(h.position) + "）");
+
+	for(const auto & [id, t] : b.towns)
+	{
+		auto it = a.towns.find(id);
+		if(it == a.towns.end())
+		{
+			out.push_back("得到了城镇 " + t.name);
+			continue;
+		}
+		const auto * town = seat.cb->getTown(id);
+		for(const auto & building : t.buildings)
+			if(!it->second.buildings.count(building) && town && !buildingName(town, building).empty())
+				out.push_back(t.name + " 建好了 " + buildingName(town, building));
+		if(t.garrison != it->second.garrison)
+			out.push_back(t.name + " 的驻军：" + it->second.garrison + " → " + t.garrison);
+	}
+	for(const auto & [id, t] : a.towns)
+		if(!b.towns.count(id))
+			out.push_back("失去了城镇 " + t.name);
+
+	for(const auto & [id, text] : b.owned)
+		if(!a.owned.count(id))
+			out.push_back("占了 " + text);
+	for(const auto & [id, text] : a.owned)
+		if(!b.owned.count(id))
+			out.push_back("丢了 " + text);
+
+	for(const auto & [id, text] : b.others)
+	{
+		auto it = a.others.find(id);
+		if(it == a.others.end())
+			out.push_back("看到 " + text);
+		else if(it->second != text)
+			out.push_back("现在 " + text);
+	}
+	for(const auto & [id, text] : a.others)
+		if(!b.others.count(id))
+			out.push_back("看不见了：" + text);
+	return out;
+}
