+std::shared_ptr<ClaudePlayer::Seat> ClaudePlayer::seatFor(const std::string & colorName)
+{
+	std::lock_guard lock(mx);
+	if(seats.empty())
+		return nullptr;
+	if(colorName.empty())
+		return seats.begin()->second;
+	for(auto & [color, seat] : seats)
+		if(boost::algorithm::iequals(color.toString(), colorName) || colorName == ::colorName(color))
+			return seat;
+	return nullptr;
+}
+
+void ClaudePlayer::run()
+{
+	setThreadName("claudePlayer");
+	while(!stopping)
+	{
+		try
+		{
+			std::vector<std::shared_ptr<Seat>> list;
+			{
+				std::lock_guard lock(mx);
+				for(auto & [color, seat] : seats)
+					list.push_back(seat);
+			}
+			for(auto & seat : list)
+			{
+				bool given;
+				bool ended;
+				QueryID query;
+				{
+					std::lock_guard lock(mx);
+					ended = seat->turnEnded;
+					seat->turnEnded = false;
+					given = seat->turnGiven;
+					seat->turnGiven = false;
+					query = seat->turnQuery;
+				}
+				if(ended)
+					finishTurn(*seat);
+				if(given)
+				{
+					seat->turnQuery = query;
+					startTurn(*seat);
+				}
+			}
+
+			pollInbox();
+
+			for(auto & seat : list)
+			{
+				if(seat->myTurn && !seat->handedOver && Clock::now() - seat->lastActivity > std::chrono::seconds(seat->timeout))
+					handOver(*seat, std::to_string(seat->timeout) + " 秒没有收到命令");
+			}
+		}
+		catch(const TerminationRequestedException &)
+		{
+			break;
+		}
+		catch(const std::exception & e)
+		{
+			logGlobal->error("Claude player: %s", e.what());
+		}
+
+		for(int i = 0; i < 4 && !stopping; ++i)
+			std::this_thread::sleep_for(std::chrono::milliseconds(50));
+	}
+}
