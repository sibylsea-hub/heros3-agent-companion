@@ -0,0 +1,197 @@
+/*
+ * ClaudeChatWindow.cpp, H3 Mod local patch (not part of VCMI)
+ *
+ * License: GNU General Public License v2.0 or later
+ *
+ */
+#include "StdInc.h"
+#include "ClaudeChatWindow.h"
+
+#include "../CPlayerInterface.h"
+#include "../CServerHandler.h"
+#include "../ClaudeBridge.h"
+#include "../GameChatHandler.h"
+#include "../GameEngine.h"
+#include "../GameInstance.h"
+#include "../gui/Shortcut.h"
+#include "../gui/WindowHandler.h"
+#include "../render/Canvas.h"
+#include "../render/Colors.h"
+#include "../render/IFont.h"
+#include "../render/IRenderHandler.h"
+#include "../widgets/Buttons.h"
+#include "../widgets/CTextInput.h"
+#include "../widgets/GraphicalPrimitiveCanvas.h"
+#include "../widgets/Images.h"
+#include "../widgets/Slider.h"
+#include "../widgets/TextControls.h"
+
+namespace
+{
+ClaudeBridge & bridge()
+{
+	return GAME->server().getGameChat().getClaudeBridge();
+}
+
+/// {...} switches colour in VCMI text, so keep braces in messages literal
+std::string escapeBraces(std::string text)
+{
+	boost::algorithm::replace_all(text, "{", "｛");
+	boost::algorithm::replace_all(text, "}", "｝");
+	return text;
+}
+}
+
+ClaudeChatWindow::ClaudeChatWindow()
+	: CWindowObject(BORDERED)
+{
+	OBJECT_CONSTRUCTION;
+
+	pos.w = 520;
+	pos.h = 420;
+
+	background = std::make_shared<FilledTexturePlayerColored>(Rect(0, 0, pos.w, pos.h));
+	if(GAME->interface())
+		background->setPlayerColor(GAME->interface()->playerID);
+	title = std::make_shared<CLabel>(pos.w / 2, 22, FONT_BIG, ETextAlignment::CENTER, Colors::YELLOW, "Claude");
+	linkLabel = std::make_shared<CLabel>(pos.w / 2, 46, FONT_SMALL, ETextAlignment::CENTER, Colors::WHITE, "");
+
+	historyBackground = std::make_shared<TransparentFilledRectangle>(Rect(12, 60, 496, 300), ColorRGBA(0, 0, 0, 128), ColorRGBA(64, 80, 128, 255), 1);
+	history = std::make_shared<CTextBox>("", Rect(16, 64, 488, 292), 1, FONT_MEDIUM);
+
+	inputBackground = std::make_shared<TransparentFilledRectangle>(Rect(12, 374, 344, 32), ColorRGBA(0, 0, 0, 192), ColorRGBA(64, 80, 128, 255), 1);
+	input = std::make_shared<CTextInput>(Rect(18, 374, 334, 32), FONT_MEDIUM, ETextAlignment::CENTERLEFT, true);
+
+	sendButton = std::make_shared<CButton>(Point(366, 375), AnimationPath::builtin("IOKAY"), CButton::tooltip("发送", "把这句话发给 Claude"), [this]() { send(); }, EShortcut::GLOBAL_ACCEPT);
+	closeButton = std::make_shared<CButton>(Point(440, 375), AnimationPath::builtin("ICANCEL"), CButton::tooltip("关闭"), [this]() { close(); }, EShortcut::GLOBAL_CANCEL);
+
+	addUsedEvents(TIME);
+	center();
+
+	bridge().markRead();
+	bridge().setListener([this]()
+	{
+		bridge().markRead();
+		refreshHistory();
+	});
+	refreshHistory();
+	refreshLink();
+}
+
+ClaudeChatWindow::~ClaudeChatWindow()
+{
+	bridge().setListener(nullptr);
+}
+
+void ClaudeChatWindow::send()
+{
+	const std::string text = boost::algorithm::trim_copy(input->getText());
+	input->setText("");
+	if(!text.empty())
+		bridge().sendFromWindow(text); // calls the listener, which refreshes the history
+}
+
+void ClaudeChatWindow::refreshHistory()
+{
+	std::string text;
+	for(const auto & message : bridge().getHistory())
+	{
+		const std::string sender = message.fromPlayer ? message.sender : "{" + escapeBraces(message.sender) + "}";
+		text += sender + "  " + message.time + "\n" + escapeBraces(message.text) + "\n\n";
+	}
+	if(text.empty())
+		text = "还没有消息。在下面打字，按回车或 √ 发给 Claude。\n\nClaude 的回复会出现在这里；关着这个窗口时，左下角的宝石上会标出有几条新消息。";
+	history->setText(text);
+	if(history->slider)
+		history->slider->scrollToMax();
+	redraw();
+}
+
+void ClaudeChatWindow::refreshLink()
+{
+	std::string description = bridge().getLinkDescription();
+	if(bridge().getLink() == ClaudeBridge::ELink::FILES)
+		description = "本机直连 Claude";
+	if(linkLabel->getText() != description)
+	{
+		linkLabel->setText(description);
+		linkLabel->setColor(bridge().getLink() == ClaudeBridge::ELink::OFFLINE ? Colors::ORANGE : Colors::WHITE);
+		redraw();
+	}
+}
+
+void ClaudeChatWindow::tick(uint32_t msPassed)
+{
+	sinceLinkCheck += msPassed;
+	if(sinceLinkCheck >= 1000)
+	{
+		sinceLinkCheck = 0;
+		refreshLink();
+	}
+}
+
+namespace
+{
+// The bottom-left gem looks just like the other three corner gems, so a tag next to it says
+// that it opens the Claude window. The gem ball sits at the left of the 46x46 gem area.
+constexpr int TAG_LEFT = 26;
+constexpr int GEM_CENTER_Y = 21;
+constexpr int TAG_PADDING = 6;
+
+std::string tagText(int unread)
+{
+	return unread <= 0 ? "Claude" : "Claude " + (unread > 9 ? std::string("9+") : std::to_string(unread));
+}
+}
+
+ClaudeChatButton::ClaudeChatButton(const Rect & area)
+	: CIntObject(LCLICK | HOVER | TIME)
+{
+	pos = area + pos.topLeft();
+	// clicks on the tag open the window too; "Claude 9+" is as wide as it gets
+	const auto & font = ENGINE->renderHandler().loadFont(FONT_SMALL);
+	pos.w = std::max(pos.w, TAG_LEFT + static_cast<int>(font->getStringWidth(tagText(10))) + 2 * TAG_PADDING);
+}
+
+void ClaudeChatButton::clickPressed(const Point & cursorPosition)
+{
+	if(!ENGINE->windows().topWindow<ClaudeChatWindow>())
+		ENGINE->windows().createAndPushWindow<ClaudeChatWindow>();
+}
+
+void ClaudeChatButton::hover(bool on)
+{
+	const int unread = bridge().getUnreadCount();
+	const std::string text = unread > 0 ? "Claude：" + std::to_string(unread) + " 条新消息，点开看" : "Claude：点开和 Claude 聊天";
+	if(on)
+		ENGINE->statusbar()->write(text);
+	else
+		ENGINE->statusbar()->clearIfMatching(text);
+}
+
+void ClaudeChatButton::tick(uint32_t msPassed)
+{
+	time += msPassed;
+}
+
+void ClaudeChatButton::showAll(Canvas & to)
+{
+	show(to);
+}
+
+void ClaudeChatButton::show(Canvas & to)
+{
+	// always there, so she can find the way in; red and blinking once a second while messages wait
+	const int unread = bridge().getUnreadCount();
+	const std::string text = tagText(unread);
+	const auto & font = ENGINE->renderHandler().loadFont(FONT_SMALL);
+	const int height = static_cast<int>(font->getLineHeight()) + 4;
+	const Rect tag(pos.x + TAG_LEFT, pos.y + GEM_CENTER_Y - height / 2, static_cast<int>(font->getStringWidth(text)) + 2 * TAG_PADDING, height);
+	const bool bright = (time / 500) % 2 == 0;
+	ColorRGBA fill(48, 32, 16, 255); // dark brown, like the frame
+	if(unread > 0)
+		fill = bright ? ColorRGBA(200, 30, 30, 255) : ColorRGBA(120, 20, 20, 255);
+	to.drawColor(tag, fill);
+	to.drawBorder(tag, Colors::YELLOW);
+	to.drawText(tag.center(), FONT_SMALL, unread > 0 ? Colors::WHITE : Colors::YELLOW, ETextAlignment::CENTER, text);
+}
