+std::string heroLine(const CGHeroInstance * h, int index)
+{
+	std::string out = "H" + std::to_string(index) + " " + h->getNameTranslated() + "（" + h->getHeroClass()->getNameTranslated() + "，" + std::to_string(h->level) + " 级）在 " + pos(h->visitablePos());
+	if(h->getVisitedTown())
+		out += std::string("，") + (h->isGarrisoned() ? "驻守" : "在城里：") + h->getVisitedTown()->getNameTranslated();
+	if(h->inBoat())
+		out += "，在船上";
+	out += "\n   行动力 " + std::to_string(h->movementPointsRemaining()) + "/" + std::to_string(h->movementPointsLimit()) + " · 魔法 " + std::to_string(h->mana) + "/" + std::to_string(h->manaLimit())
+		+ " · 攻 " + std::to_string(h->getPrimSkillLevel(PrimarySkill::ATTACK)) + " 防 " + std::to_string(h->getPrimSkillLevel(PrimarySkill::DEFENSE))
+		+ " 力 " + std::to_string(h->getPrimSkillLevel(PrimarySkill::SPELL_POWER)) + " 知 " + std::to_string(h->getPrimSkillLevel(PrimarySkill::KNOWLEDGE));
+	out += "\n   兵：" + armyText(*h);
+	std::string skills;
+	for(const auto & [skill, level] : h->secSkills)
+	{
+		if(!skill.hasValue())
+			continue;
+		static const char * levels[] = {"", "初级", "中级", "高级"};
+		skills += (skills.empty() ? "" : "，") + std::string(levels[std::clamp<int>(level, 0, 3)]) + skill.toEntity(LIBRARY)->getNameTranslated();
+	}
+	if(!skills.empty())
+		out += "\n   技能：" + skills;
+	std::string arts;
+	for(const auto & [slot, info] : h->artifactsWorn)
+	{
+		if(info.locked || !info.getArt() || slot.getNum() >= ArtifactPosition::MACH1)
+			continue;
+		arts += (arts.empty() ? "" : "，") + info.getArt()->getType()->getNameTranslated();
+	}
+	if(!h->artifactsInBackpack.empty())
+		arts += (arts.empty() ? "" : "，") + std::string("背包 ") + std::to_string(h->artifactsInBackpack.size()) + " 件";
+	if(!arts.empty())
+		out += "\n   宝物：" + arts;
+	return out;
+}
