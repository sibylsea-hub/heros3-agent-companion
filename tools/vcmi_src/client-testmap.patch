+void post(const Seat & seat, const std::string & kind, const std::string & text, const std::string & id = {}, std::optional<bool> ok = std::nullopt)
+{
+	std::string line = "{\"ts\": " + jsonString(timestamp()) + ", \"kind\": " + jsonString(kind) + ", \"color\": " + jsonString(seat.color.toString())
+		+ ", \"day\": " + std::to_string(seat.cb->getDate(Date::DAY));
